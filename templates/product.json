    "co_ppm_explainer_jTaDVy": {
      "type": "co-ppm-explainer",
      "blocks": {
        "level_e44gB6": {
          "type": "level",
          "settings": {
            "range": "0–15 PPM",
            "start": 0,
            "scale_label": "Unauffällig",
            "title": "Normale Raumluft / unauffällig",
            "text": "<p>Bei niedrigen Werten bestehen in der Regel keine akuten Beschwerden. Dennoch zeigt die Anzeige, ob sich die Luftqualität verändert.</p>",
            "color": "#18864b"
          }
        },
        "level_89xABh": {
          "type": "level",
          "settings": {
            "range": "16–29 PPM",
            "start": 16,
            "scale_label": "Erste Belastung",
            "title": "Erste Belastung möglich",
            "text": "<p>Bei längerer Exposition können Müdigkeit, leichte Kopfschmerzen oder Konzentrationsprobleme auftreten – besonders bei empfindlichen Personen.</p>",
            "color": "#f5c518"
          }
        },
        "level_GkkXq8": {
          "type": "level",
          "settings": {
            "range": "30–50 PPM",
            "start": 30,
            "scale_label": "Warnstufe",
            "title": "Deutliche Warnstufe",
            "text": "<p>Hier können bereits Beschwerden wie Kopfschmerzen, Benommenheit, Übelkeit und verlangsamte Reaktionen auftreten. Für Kinder, ältere Menschen und gesundheitlich vorbelastete Personen kann dieser Bereich besonders kritisch sein.</p>",
            "color": "#f08a24"
          }
        },
        "level_q6mrhU": {
          "type": "level",
          "settings": {
            "range": "51–69 PPM",
            "start": 51,
            "scale_label": "Ernste Belastung",
            "title": "Ernstzunehmende Belastung",
            "text": "<p>In diesem Bereich steigt das Risiko für stärkere Symptome wie Verwirrtheit, deutliche Schwäche und Orientierungslosigkeit. Spätestens jetzt ist schnelles Handeln wichtig.</p>",
            "color": "#c9441a"
          }
        },
        "level_pyVyza": {
          "type": "level",
          "settings": {
            "range": "70+ PPM",
            "start": 70,
            "scale_label": "Akute Gefahr",
            "title": "Akute Gefahr",
            "text": "<p>Hohe Kohlenmonoxid-Konzentrationen können schnell gefährlich werden. Jetzt zählt jede Minute.</p>",
            "color": "#c1121c"
          }
        },
        "item_BpAigG": {
          "type": "item",
          "settings": {
            "title": "Kinder reagieren empfindlicher",
            "text": "<p>Kinder atmen schneller, ihr Körper ist kleiner und sie reagieren empfindlicher auf belastete Raumluft. Beschwerden können daher früher auftreten als bei Erwachsenen.</p>",
            "icon": "family"
          }
        },
        "item_B9byPa": {
          "type": "item",
          "settings": {
            "title": "Längere Belastung kann gefährlich sein",
            "text": "<p>Nicht nur hohe Spitzenwerte sind problematisch. Auch eine über Stunden anhaltende Belastung mit mittleren Werten kann ernst zu nehmende Auswirkungen haben.</p>",
            "icon": "clock"
          }
        },
        "item_3YYUtB": {
          "type": "item",
          "settings": {
            "title": "Klassische Warnmelder zeigen oft nicht das ganze Bild",
            "text": "<p>Ein herkömmlicher Melder warnt in erster Linie bei kritischen Alarmwerten. Er zeigt jedoch nicht immer, wie sich Werte vorher entwickeln.</p>",
            "icon": "bell"
          }
        },
        "item_F7ETdE": {
          "type": "item",
          "settings": {
            "title": "Früher sehen heißt früher handeln",
            "text": "<p>Wer die Werte im Blick hat, kann schneller lüften, reagieren und Gefahren ernst nehmen – bevor die Situation eskaliert.</p>",
            "icon": "eye"
          }
        }
      },
      "block_order": [
        "level_e44gB6",
        "level_89xABh",
        "level_GkkXq8",
        "level_q6mrhU",
        "level_pyVyza",
        "item_BpAigG",
        "item_B9byPa",
        "item_3YYUtB",
        "item_F7ETdE"
      ],
      "settings": {
        "overline": "Frühzeitig erkennen. Rechtzeitig handeln.",
        "heading": "Was Kohlenmonoxid schon bei <em>niedrigen Werten</em> im Körper auslösen kann",
        "subheading": "<p>Kohlenmonoxid kann unbemerkt in die Raumluft gelangen. Noch bevor ein klassischer Alarm auslöst, können bereits Beschwerden wie Müdigkeit, Kopfschmerzen, Konzentrationsprobleme oder Übelkeit auftreten.</p>",
        "header_alignment": "center",
        "chart_title": "So ordnen sich CO-Werte in der Raumluft ein",
        "chart_unit": "Kohlenmonoxid-Konzentration in ppm (Teile pro Million)",
        "scale_max": 100,
        "marker_1_value": 30,
        "marker_1_text": "Ein Melder nach Norm schweigt hier mindestens 2 Stunden. SICHERLUFT zeigt den Wert schon am Display.",
        "marker_2_value": 50,
        "marker_2_text": "Selbst hier verlangt die Norm EN 50291-1 den Alarm erst nach 60 bis 90 Minuten.",
        "footnote": "<p>Orientierungswerte: Wie Kohlenmonoxid wirkt, hängt von Konzentration, Dauer und Gesundheitszustand ab. Die Einordnung ersetzt keine ärztliche Beratung. Bei Verdacht auf eine Vergiftung: Raum sofort verlassen und den Notruf 112 wählen.</p>",
        "note_heading": "Gefährlich ist nicht nur der Spitzenwert&nbsp;– sondern auch die Dauer der Belastung.",
        "note_text": "<p>Schon niedrigere Kohlenmonoxid-Werte können problematisch werden, wenn sie über längere Zeit unbemerkt in der Raumluft bleiben. Genau deshalb ist es entscheidend, Veränderungen frühzeitig zu sehen – nicht erst dann, wenn es kritisch wird.</p>",
        "note_icon": "clock",
        "accordion_heading": "Warum frühes Erkennen so entscheidend ist",
        "accordion_single": true,
        "accordion_first_open": true,
        "button_label": "",
        "button_link": "",
        "background_color": "#ffffff",
        "card_color": "#ffffff",
        "text_color": "#082b4a",
        "accent_color": "#0794f8",
        "radius": 20,
        "padding_top": 80,
        "padding_bottom": 80,
        "max_width": 1200
      }
    },
