    "customer_reviews_carousel_h7TQED": {
      "type": "customer-reviews-carousel",
      "blocks": {
        "review_familie_sl1": {
          "type": "review",
          "settings": {
            "rating": 5,
            "review_title": "Direkt das Bundle genommen",
            "review_text": "Wir haben uns gleich für mehrere Geräte entschieden – eins fürs Schlafzimmer, eins fürs Kinderzimmer und eins für den Flur bei der Gastherme. So mussten wir nicht überlegen, welcher Raum wichtiger ist. Die Einrichtung ging bei allen dreien gleich schnell, und jedes zeigt seine Werte einzeln an.",
            "reviewer_name": "Nadine H.",
            "reviewer_age": "",
            "show_verified_badge": false,
            "show_purchased_product": true,
            "product_reference": "sicherluft-4-in-1-co-gasmelder",
            "quantity": 3,
            "show_purchase_date": false
          }
        },
        "review_wohnmobil_sl2": {
          "type": "review",
          "settings": {
            "rating": 5,
            "review_title": "Für unser Wohnmobil gekauft",
            "review_text": "Da wir viel mit dem Wohnmobil unterwegs sind, wollten wir neben dem eingebauten Rauchmelder auch eine Kontrolle für Gas und Kohlenmonoxid haben. Das Gerät lässt sich einfach an die Bordsteckdose anschließen und läuft seitdem unauffällig mit – genau das, was wir für unterwegs gesucht haben.",
            "reviewer_name": "Thomas B.",
            "reviewer_age": "",
            "show_verified_badge": false,
            "show_purchased_product": true,
            "product_reference": "sicherluft-4-in-1-co-gasmelder",
            "quantity": 1,
            "show_purchase_date": false
          }
        },
        "review_zuhause_sl3": {
          "type": "review",
          "settings": {
            "rating": 5,
            "review_title": "Einfach eingesteckt und fertig",
            "review_text": "Für unsere Wohnung reicht uns ein einzelnes Gerät völlig aus. Ich hatte keine Lust auf komplizierte Ersteinrichtung, aber hier musste ich nur den Stecker in die Dose stecken. Auf dem Display sieht man auf einen Blick, ob alles im normalen Bereich liegt.",
            "reviewer_name": "Julia M.",
            "reviewer_age": "",
            "show_verified_badge": false,
            "show_purchased_product": true,
            "product_reference": "sicherluft-4-in-1-co-gasmelder",
            "quantity": 1,
            "show_purchase_date": false
          }
        },
        "review_reise_sl4": {
          "type": "review",
          "settings": {
            "rating": 5,
            "review_title": "Eins zuhause, eins für unterwegs",
            "review_text": "Bei uns läuft ein Gerät dauerhaft zu Hause im Flur, das zweite aus dem Set nehmen wir je nach Saison mit ins Wohnmobil oder ins Ferienhaus. So ist immer eines da, ohne dass wir etwas umbauen oder neu einrichten müssen.",
            "reviewer_name": "Frank S.",
