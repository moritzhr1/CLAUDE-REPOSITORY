    "store_faq_sl_home": {
      "type": "store-faq",
      "blocks": {
        "faq_sl1": {
          "type": "faq_item",
          "settings": {
            "question": "Welche Werte erkennt SICHERLUFT?",
            "answer": "<p>SICHERLUFT überwacht <strong>Kohlenmonoxid (CO) und brennbare Gase wie Erdgas/Methan und LPG</strong>. Zusätzlich zeigt das Gerät <strong>Temperatur und Luftfeuchtigkeit</strong> an. </p>"
          }
        },
        "faq_sl2": {
          "type": "faq_item",
          "settings": {
            "question": "Wo sollte ich das Gerät platzieren?",
            "answer": "<p>Platziere SICHERLUFT in Räumen, in denen sich Personen aufhalten oder potenzielle Gasquellen befinden – zum Beispiel in <strong>Wohn-, Schlaf- oder Heizungsbereichen</strong>. Bei Erdgas empfiehlt sich eine höhere Position, da Erdgas leichter als Luft ist. Die genaue Platzierung sollte sich immer nach der verwendeten Gasart und der Bedienungsanleitung richten.</p>"
          }
        },
        "faq_sl3": {
          "type": "faq_item",
          "settings": {
            "question": "Muss das Gerät montiert werden?",
            "answer": "<p>Nein. SICHERLUFT wird <strong>direkt in eine geeignete Steckdose gesteckt</strong>. Bohren oder eine feste Wandmontage sind nicht erforderlich.</p>"
          }
        },
        "faq_sl4": {
          "type": "faq_item",
          "settings": {
            "question": "Brauche ich eine App?",
            "answer": "<p>Nein. SICHERLUFT funktioniert <strong>eigenständig und ohne App</strong>. Die Messwerte werden direkt auf dem Display angezeigt und bei einer erkannten Gefahr warnt das Gerät mit einem akustischen und visuellen Alarm.</p>"
          }
        },
        "faq_sl5": {
          "type": "faq_item",
          "settings": {
            "question": "Kann ich es im Wohnmobil verwenden?",
            "answer": "<p>Ja, grundsätzlich kann SICHERLUFT auch im <strong>Wohnmobil oder Caravan</strong> eingesetzt werden, sofern eine geeignete Stromversorgung vorhanden ist. Das Gerät überwacht dort ebenfalls Kohlenmonoxid und brennbare Gase. Bei der Positionierung sollte besonders auf die verwendete Gasart und die Vorgaben der Bedienungsanleitung geachtet werden.</p>"
          }
        }
      },
