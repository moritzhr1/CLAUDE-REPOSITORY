{%- comment -%}
  SICHERLUFT Landingpage-Kit: Symbol-Illustration „Einsatz bei Nacht“ (Blaulicht neben einem Wohnmobil).
  Rein dekorativ (aria-hidden) und bewusst ohne Personen, Verletzte, Logos, Aufschriften oder
  Organisationsmerkmale – ein visuelles Warnsignal, keine Darstellung eines echten Einsatzes.
  Die Blaulicht-Gruppen (.sl-es-flash-a/-b) werden in assets/sl-lp.css animiert; bei
  „Bewegung reduzieren“ bleibt das Licht statisch.
  Wird durch ein echtes Symbolfoto ersetzt, sobald in der Section ein Bild hinterlegt ist.

  Accepts:
  - uid: {String} eindeutiges Präfix für SVG-IDs (z. B. section.id)
{%- endcomment -%}
{%- assign p = uid | default: 'es' | handleize | prepend: 'sles-' -%}
<svg class="sl-lp-escene" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMax slice" role="presentation" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="{{ p }}-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#01050b"/>
      <stop offset="0.55" stop-color="#051226"/>
      <stop offset="0.8" stop-color="#0a2140"/>
      <stop offset="1" stop-color="#061427"/>
    </linearGradient>
    <linearGradient id="{{ p }}-ground" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#06111f"/>
      <stop offset="1" stop-color="#010409"/>
    </linearGradient>
    <radialGradient id="{{ p }}-blue" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#5aa2ff" stop-opacity="0.75"/>
      <stop offset="0.35" stop-color="#2463ff" stop-opacity="0.32"/>
      <stop offset="1" stop-color="#1848ff" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="{{ p }}-core" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#e8f2ff" stop-opacity="1"/>
      <stop offset="0.4" stop-color="#6fb0ff" stop-opacity="0.9"/>
      <stop offset="1" stop-color="#2463ff" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="{{ p }}-pool" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#3a7bff" stop-opacity="0.5"/>
      <stop offset="1" stop-color="#3a7bff" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="{{ p }}-warm" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffb347" stop-opacity="0.45"/>
      <stop offset="1" stop-color="#ffb347" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="{{ p }}-camper" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#0a1626"/>
      <stop offset="0.7" stop-color="#10233a"/>
      <stop offset="1" stop-color="#1a3a63"/>
    </linearGradient>
    <linearGradient id="{{ p }}-rim" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0.55" stop-color="#4d8dff" stop-opacity="0"/>
      <stop offset="1" stop-color="#4d8dff" stop-opacity="0.55"/>
    </linearGradient>
    <linearGradient id="{{ p }}-van" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1b2c42"/>
      <stop offset="1" stop-color="#0c1726"/>
    </linearGradient>
    <linearGradient id="{{ p }}-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2f5d9a"/>
      <stop offset="1" stop-color="#08182b"/>
    </linearGradient>
    <linearGradient id="{{ p }}-haze" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0b2346" stop-opacity="0"/>
      <stop offset="1" stop-color="#0b2346" stop-opacity="0.55"/>
    </linearGradient>
    <radialGradient id="{{ p }}-vignette" cx="0.5" cy="0.45" r="0.75">
      <stop offset="0.6" stop-color="#000" stop-opacity="0"/>
      <stop offset="1" stop-color="#000" stop-opacity="0.6"/>
    </radialGradient>
  </defs>

  <rect width="1200" height="800" fill="url(#{{ p }}-sky)"/>
  <g fill="#ffffff">
    <circle cx="90" cy="70" r="1.3" opacity=".6"/>
    <circle cx="240" cy="140" r="1" opacity=".4"/>
    <circle cx="380" cy="60" r="1.2" opacity=".55"/>
    <circle cx="520" cy="170" r=".9" opacity=".35"/>
    <circle cx="660" cy="90" r="1.1" opacity=".5"/>
    <circle cx="1010" cy="70" r="1" opacity=".4"/>
    <circle cx="1130" cy="160" r="1.2" opacity=".45"/>
    <circle cx="160" cy="260" r=".8" opacity=".3"/>
  </g>

  {%- comment -%} Blaulicht (Gruppe A) – großer Schein am Himmel {%- endcomment -%}
  <g class="sl-es-flash-a">
    <circle cx="758" cy="487" r="470" fill="url(#{{ p }}-blue)"/>
    <circle cx="1143" cy="424" r="330" fill="url(#{{ p }}-blue)"/>
  </g>
  <g class="sl-es-flash-b">
    <circle cx="778" cy="487" r="470" fill="url(#{{ p }}-blue)"/>
    <circle cx="807" cy="424" r="330" fill="url(#{{ p }}-blue)"/>
  </g>

  {%- comment -%} Baumreihe und Gelände {%- endcomment -%}
  <path d="M0 600 C140 560 260 574 380 584 S620 560 760 572 S1040 556 1200 566 L1200 680 L0 680 Z" fill="#040c18"/>
  <g fill="#030912">
    <path d="M20 604 L44 536 L68 604 Z"/>
    <path d="M58 602 L90 512 L122 602 Z"/>
    <path d="M110 600 L132 548 L154 600 Z"/>
    <path d="M430 590 L452 530 L474 590 Z"/>
    <path d="M1050 584 L1076 520 L1102 584 Z"/>
    <path d="M1096 588 L1128 500 L1160 588 Z"/>
    <path d="M1150 590 L1174 540 L1198 590 Z"/>
  </g>
  <rect y="652" width="1200" height="148" fill="url(#{{ p }}-ground)"/>

  {%- comment -%} Warmes Licht aus dem Wohnmobil auf dem Boden {%- endcomment -%}
  <ellipse cx="560" cy="664" rx="150" ry="16" fill="url(#{{ p }}-warm)"/>

  {%- comment -%} Wohnmobil (Silhouette, Front links) {%- endcomment -%}
  <g transform="translate(150 304)">
    <path d="M44 330 L40 312 Q40 300 52 296 L78 290 L112 238 Q118 231 128 230 L156 224 Q166 205 186 203 L470 203 Q488 203 488 221 L488 318 Q488 330 476 330 L398 330 A28 28 0 0 0 342 330 L146 330 A28 28 0 0 0 90 330 Z" fill="url(#{{ p }}-camper)"/>
    <path class="sl-es-flash-b" d="M44 330 L40 312 Q40 300 52 296 L78 290 L112 238 Q118 231 128 230 L156 224 Q166 205 186 203 L470 203 Q488 203 488 221 L488 318 Q488 330 476 330 L398 330 A28 28 0 0 0 342 330 L146 330 A28 28 0 0 0 90 330 Z" fill="url(#{{ p }}-rim)"/>
    <path d="M86 284 L114 241 Q118 236 126 235 L156 230 L156 272 L92 272 Z" fill="#07111d"/>
    <rect x="190" y="228" width="58" height="34" rx="7" fill="#07111d"/>
    <rect x="262" y="222" width="38" height="100" rx="6" fill="#0b1928" stroke="#1d3350" stroke-width="1.4"/>
    <rect x="316" y="228" width="40" height="28" rx="6" fill="#07111d"/>
    <rect x="404" y="228" width="62" height="34" rx="7" fill="#ffb347" opacity=".82"/>
    <rect x="404" y="228" width="62" height="34" rx="7" fill="#ff8a00" opacity=".25"/>
    <rect x="170" y="294" width="318" height="3" fill="#4d8dff" opacity=".35"/>
    <g fill="#02060c">
      <circle cx="118" cy="334" r="22"/>
      <circle cx="370" cy="334" r="22"/>
    </g>
    <g fill="#1a2a3d">
      <circle cx="118" cy="334" r="9"/>
      <circle cx="370" cy="334" r="9"/>
    </g>
  </g>

  {%- comment -%} Einsatzfahrzeug (neutrale Silhouette, ohne Beschriftung) {%- endcomment -%}
  <g>
    <path d="M700 632 L700 574 Q700 558 712 552 L744 506 Q752 496 764 494 L790 492 L790 440 Q790 428 802 428 L1148 428 Q1160 428 1160 440 L1160 628 Q1160 640 1148 640 L1102 640 A29 29 0 0 0 1044 640 L802 640 A29 29 0 0 0 744 640 L708 640 Q700 640 700 632 Z" fill="url(#{{ p }}-van)"/>
    <path d="M712 566 L744 520 Q750 512 758 512 L786 512 L786 566 Z" fill="url(#{{ p }}-glass)"/>
    <rect x="1010" y="468" width="96" height="40" rx="5" fill="#0a1422"/>
    <rect x="790" y="560" width="370" height="6" fill="#c9d6e6" opacity=".22"/>
    <path d="M790 440 L790 640" stroke="#0a1422" stroke-width="2"/>
    <rect x="700" y="586" width="8" height="13" rx="2" fill="#fff4d6"/>
    <rect x="746" y="480" width="44" height="12" rx="3" fill="#0a1422"/>
    <rect x="796" y="419" width="22" height="10" rx="2" fill="#0a1422"/>
    <rect x="1132" y="419" width="22" height="10" rx="2" fill="#0a1422"/>
    <g fill="#02060c">
      <circle cx="773" cy="640" r="23"/>
      <circle cx="1073" cy="640" r="23"/>
    </g>
    <g fill="#1a2a3d">
      <circle cx="773" cy="640" r="9"/>
      <circle cx="1073" cy="640" r="9"/>
    </g>
  </g>

  {%- comment -%} Blaulicht (Lampen + Kern + Spiegelung auf nassem Boden) {%- endcomment -%}
  <g class="sl-es-flash-a">
    <rect x="748" y="482" width="18" height="8" rx="2" fill="#bcd8ff"/>
    <rect x="1133" y="420" width="20" height="8" rx="2" fill="#bcd8ff"/>
    <circle cx="757" cy="486" r="46" fill="url(#{{ p }}-core)"/>
    <circle cx="1143" cy="424" r="40" fill="url(#{{ p }}-core)"/>
    <ellipse cx="760" cy="676" rx="380" ry="22" fill="url(#{{ p }}-pool)"/>
  </g>
  <g class="sl-es-flash-b">
    <rect x="770" y="482" width="18" height="8" rx="2" fill="#bcd8ff"/>
    <rect x="797" y="420" width="20" height="8" rx="2" fill="#bcd8ff"/>
    <circle cx="779" cy="486" r="46" fill="url(#{{ p }}-core)"/>
    <circle cx="807" cy="424" r="40" fill="url(#{{ p }}-core)"/>
    <ellipse cx="820" cy="680" rx="380" ry="22" fill="url(#{{ p }}-pool)"/>
  </g>

  <rect y="420" width="1200" height="380" fill="url(#{{ p }}-haze)"/>
  <rect width="1200" height="800" fill="url(#{{ p }}-vignette)"/>
</svg>
