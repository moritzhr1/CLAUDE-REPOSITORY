{%- comment -%}
  SICHERLUFT Landingpage-Kit: ermittelt, ob ein Block live angezeigt werden darf.

  Gibt aus:
    ""             – live sichtbar
    "claim"        – enthält [CLAIM VERIFIZIEREN] / [PRODUKTDATEN] / [QUELLE]
    "missing"      – Pflicht-Link oder Pflicht-Inhalt fehlt
    "unpublished"  – Pflicht-Link zeigt auf eine nicht veröffentlichte Seite

  Accepts:
  - block: {Object} Block der sl-lp-cards Section
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign check_text = ''
  assign required_link = ''
  assign needs_link = false
  assign has_content = true

  case block.type
    when 'card'
      assign check_text = s.label | append: ' ' | append: s.belief | append: ' ' | append: s.title | append: ' ' | append: s.text | append: ' ' | append: s.link_label | append: ' ' | append: s.link
      if s.link_required
        assign needs_link = true
        assign required_link = s.link
      endif
    when 'fact'
      assign check_text = s.value | append: ' ' | append: s.text | append: ' ' | append: s.source_label | append: ' ' | append: s.source_link
    when 'stat'
      assign check_text = s.value | append: ' ' | append: s.text
      if s.value == blank
        assign has_content = false
      endif
    when 'source'
      assign check_text = s.label | append: ' ' | append: s.publisher | append: ' ' | append: s.quote | append: ' ' | append: s.link
      if s.label == blank
        assign has_content = false
      endif
    when 'note'
      assign check_text = s.text
      if s.text == blank
        assign has_content = false
      endif
    when 'button'
      assign check_text = s.label | append: ' ' | append: s.link
      assign needs_link = true
      assign required_link = s.link
    when 'video'
      assign check_text = s.title | append: ' ' | append: s.creator | append: ' ' | append: s.disclosure | append: ' ' | append: s.text
      if s.video == blank and s.video_url == blank
        assign has_content = false
      endif
    when 'person'
      assign check_text = s.name | append: ' ' | append: s.role | append: ' ' | append: s.text | append: ' ' | append: s.link
      if s.name == blank or s.text == blank
        assign has_content = false
      endif
  endcase

  capture claim_state
    render 'sl-lp-claim-check', text: check_text
  endcapture

  assign state = ''
  if claim_state contains 'unverified'
    assign state = 'claim'
  elsif has_content == false
    assign state = 'missing'
  elsif needs_link
    capture link_state
      render 'sl-lp-link-status', link: required_link
    endcapture
    assign link_state = link_state | strip
    if link_state != blank
      assign state = link_state
    endif
  endif
  echo state
-%}
