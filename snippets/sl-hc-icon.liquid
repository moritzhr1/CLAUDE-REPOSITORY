{%- comment -%}
  SICHERLUFT Heizsaison-Check: zusätzliche Liniensymbole (24 × 24, currentColor), gleicher Stil wie
  snippets/sl-lp-icon.liquid. Symbole, die es dort schon gibt, bitte weiter über sl-lp-icon rendern.

  Accepts:
  - name: {String} boiler | fireplace | pellet | heatpump | question | wrench | calendar | basement |
          garage | sofa | none
  - size: {Number} Kantenlänge in px (optional, Standard 24)
  - class: {String} zusätzliche CSS-Klasse (optional)
{%- endcomment -%}
{%- assign icon_size = size | default: 24 -%}
{%- if name != blank -%}
  <svg class="sl-lp-icon {{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case name -%}
      {%- when 'boiler' -%}
        <rect x="5" y="3" width="14" height="15" rx="2"/><path d="M5 13.5h14"/><circle cx="9" cy="16" r=".6"/><path d="M12.5 16h3"/><path d="M8.5 18v3M12 18v3M15.5 18v3"/><path d="M12 6.2c1.4 1.3 1.6 2.4.9 3.4-.4.6-1.4.8-2 .2-.6-.6-.4-1.5.1-2"/>
      {%- when 'fireplace' -%}
        <path d="M3 21h18"/><path d="M5 21V9h14v12"/><path d="M3.5 9h17"/><path d="M8 21v-6a4 4 0 0 1 8 0v6"/><path d="M12 19.5c-1.3 0-2-.9-2-1.9 0-1.2 1-1.7 1.5-2.8.5.9 2.5 1.5 2.5 2.9 0 1-.7 1.8-2 1.8z"/><path d="M10 9V3.5h4V9"/>
      {%- when 'pellet' -%}
        <rect x="6" y="3" width="12" height="18" rx="2"/><path d="M6 9h12"/><circle cx="10" cy="6" r=".6"/><circle cx="12.5" cy="6" r=".6"/><circle cx="15" cy="6" r=".6"/><path d="M12 18c-1.5 0-2.3-1-2.3-2.1 0-1.4 1.1-2 1.7-3.2.6 1 2.9 1.7 2.9 3.3 0 1.1-.8 2-2.3 2z"/>
      {%- when 'heatpump' -%}
        <rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="10" cy="12" r="4"/><path d="M10 8v8M6 12h8M7.2 9.2l5.6 5.6M12.8 9.2l-5.6 5.6"/><path d="M16.5 9h2M16.5 12h2M16.5 15h2"/>
      {%- when 'question' -%}
        <circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.1-2.4 3.8"/><circle cx="12" cy="17" r=".6"/>
      {%- when 'wrench' -%}
        <path d="M14.8 5.2a4.4 4.4 0 0 0-5.6 5.6L3.8 16.2a1.9 1.9 0 0 0 2.7 2.7l5.4-5.4a4.4 4.4 0 0 0 5.6-5.6l-2.8 2.8-2.4-.3-.3-2.4z"/>
      {%- when 'calendar' -%}
        <rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M8.5 14.5l2.2 2.2 4.8-4.8"/>
      {%- when 'basement' -%}
        <path d="M3 10.5 12 4l9 6.5"/><path d="M5 9v12h14V9"/><path d="M5 15h14"/><path d="M8 21v-3h3v-3h3v-3"/>
      {%- when 'garage' -%}
        <path d="M3 10 12 4l9 6v11H3z"/><path d="M6.5 21v-7.5h11V21"/><path d="M7.5 18.5h9"/><circle cx="9" cy="18.5" r=".6"/><circle cx="15" cy="18.5" r=".6"/>
      {%- when 'sofa' -%}
        <path d="M5 11V8.5A2.5 2.5 0 0 1 7.5 6h9A2.5 2.5 0 0 1 19 8.5V11"/><path d="M3 12.5a2 2 0 0 1 4 0V15h10v-2.5a2 2 0 0 1 4 0V18H3z"/><path d="M5 18v2M19 18v2"/>
      {%- when 'none' -%}
        <circle cx="12" cy="12" r="9"/><path d="M5.6 18.4 18.4 5.6"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
