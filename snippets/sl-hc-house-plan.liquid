{%- comment -%}
  SICHERLUFT Heizsaison-Check: schematischer Schnitt durch ein Einfamilienhaus mit Keller und Garage
  (gleicher Zeichenstil wie snippets/sl-lp-camper-plan.liquid). Zeigt typische Bereiche:
  Schlafzimmer, Wohnbereich, Küche, Therme/Heizraum, Keller, Garage. Bewusst schematisch – keine
  Montagepositionen. Die Bereichsnummern liegen als HTML darüber (sections/sl-hc-house.liquid).

  Accepts:
  - uid: {String} eindeutiges Präfix für SVG-IDs
{%- endcomment -%}
{%- assign p = uid | default: 'sl' | handleize | prepend: 'slhp-' -%}
<svg class="sl-lp-plan__svg" viewBox="0 0 900 560" role="presentation" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="{{ p }}-grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="#082b4a" stroke-opacity=".05" stroke-width="1"/>
    </pattern>
    <pattern id="{{ p }}-soil" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0V14" stroke="#082b4a" stroke-opacity=".12" stroke-width="2"/>
    </pattern>
  </defs>
  <rect width="900" height="560" fill="url(#{{ p }}-grid)"/>

  {%- comment -%} Erdreich um den Keller {%- endcomment -%}
  <rect x="40" y="412" width="820" height="148" fill="url(#{{ p }}-soil)"/>
  <path d="M40 412 H860" stroke="#082b4a" stroke-opacity=".45" stroke-width="2"/>

  {%- comment -%} Dach {%- endcomment -%}
  <path d="M96 192 L372 58 L648 192" fill="#ffffff" stroke="#082b4a" stroke-width="3" stroke-linejoin="round"/>
  <rect x="520" y="86" width="30" height="58" fill="#ffffff" stroke="#082b4a" stroke-width="2.5"/>

  {%- comment -%} Hauskörper mit Keller {%- endcomment -%}
  <rect x="120" y="178" width="504" height="352" fill="#ffffff" stroke="#082b4a" stroke-width="3"/>
  <path d="M120 300 H624 M120 412 H624" stroke="#082b4a" stroke-width="2.5"/>
  <path d="M372 178 V300 M396 300 V412 M372 412 V530" stroke="#082b4a" stroke-opacity=".55" stroke-width="2"/>
  <rect x="120" y="412" width="504" height="118" fill="#eef4fa" fill-opacity=".7"/>
  <path d="M120 530 H624" stroke="#082b4a" stroke-width="3"/>

  {%- comment -%} Treppe EG → Keller (angedeutet) {%- endcomment -%}
  <path d="M340 412 L372 444" stroke="#082b4a" stroke-opacity=".3" stroke-width="1.5"/>

  {%- comment -%} Fenster {%- endcomment -%}
  <g fill="#dcefff" stroke="#082b4a" stroke-opacity=".35" stroke-width="1.5">
    <rect x="150" y="214" width="62" height="46" rx="4"/>
    <rect x="452" y="214" width="62" height="46" rx="4"/>
    <rect x="150" y="330" width="70" height="50" rx="4"/>
    <rect x="530" y="330" width="62" height="46" rx="4"/>
    <rect x="160" y="424" width="56" height="20" rx="3"/>
  </g>

  {%- comment -%} Schlafzimmer: Bett {%- endcomment -%}
  <g fill="#f4f8fb" stroke="#082b4a" stroke-opacity=".6" stroke-width="1.5">
    <rect x="236" y="262" width="112" height="32" rx="5"/>
    <rect x="236" y="246" width="30" height="18" rx="5"/>
    <path d="M236 294 V300 M348 294 V300" fill="none"/>
  </g>
  {%- comment -%} Zweites Zimmer im OG: Schrank {%- endcomment -%}
  <rect x="542" y="226" width="54" height="74" rx="3" fill="#f4f8fb" stroke="#082b4a" stroke-opacity=".45" stroke-width="1.5"/>

  {%- comment -%} Wohnbereich: Sofa und Lampe {%- endcomment -%}
  <g fill="#f4f8fb" stroke="#082b4a" stroke-opacity=".6" stroke-width="1.5">
    <path d="M238 412 V378 Q238 370 246 370 H342 Q350 370 350 378 V412"/>
    <rect x="228" y="384" width="18" height="28" rx="5"/>
    <rect x="342" y="384" width="18" height="28" rx="5"/>
    <path d="M310 336 H330 L326 350 H314 Z" fill="#fff5d8"/>
    <path d="M320 350 V412" fill="none"/>
  </g>

  {%- comment -%} Küche: Zeile, Kochfeld, Wandtherme (Gasetagenheizung) {%- endcomment -%}
  <g stroke="#082b4a" stroke-width="1.5">
    <rect x="418" y="372" width="96" height="40" rx="3" fill="#f4f8fb" stroke-opacity=".6"/>
    <path d="M418 384 H514" fill="none" stroke-opacity=".35"/>
    <ellipse cx="440" cy="370" rx="11" ry="3" fill="#082b4a" fill-opacity=".8" stroke="none"/>
    <ellipse cx="472" cy="370" rx="11" ry="3" fill="#082b4a" fill-opacity=".8" stroke="none"/>
    <rect x="424" y="318" width="40" height="44" rx="4" fill="#ffffff" stroke-opacity=".7"/>
    <path d="M424 350 H464" fill="none" stroke-opacity=".4"/>
    <rect x="432" y="354" width="12" height="4" rx="1" fill="#079bf8" fill-opacity=".8" stroke="none"/>
    <path d="M436 318 V304 M452 318 V304" fill="none" stroke-opacity=".5"/>
  </g>

  {%- comment -%} Keller: Regal {%- endcomment -%}
  <g fill="none" stroke="#082b4a" stroke-opacity=".5" stroke-width="1.5">
    <path d="M244 458 V530 M314 458 V530 M244 476 H314 M244 496 H314 M244 516 H314"/>
    <rect x="252" y="464" width="16" height="12" fill="#f4f8fb"/>
    <rect x="284" y="484" width="20" height="12" fill="#f4f8fb"/>
  </g>

  {%- comment -%} Heizraum: Heizkessel/Therme mit Abgasrohr zum Schornstein {%- endcomment -%}
  <g stroke="#082b4a" stroke-width="1.5">
    <rect x="470" y="446" width="56" height="84" rx="5" fill="#ffffff" stroke-opacity=".8"/>
    <path d="M470 492 H526" fill="none" stroke-opacity=".4"/>
    <rect x="480" y="500" width="16" height="6" rx="1" fill="#079bf8" fill-opacity=".8" stroke="none"/>
    <path d="M498 446 V430 H535 V144" fill="none" stroke-opacity=".35" stroke-dasharray="6 5"/>
    <path d="M498 470 c6 -6 6 -12 0 -18" fill="none" stroke="#ff5b1f" stroke-opacity=".8"/>
  </g>

  {%- comment -%} Garage mit Auto {%- endcomment -%}
  <path d="M624 238 H812 V412 H624" fill="#ffffff" stroke="#082b4a" stroke-width="3" stroke-linejoin="round"/>
  <path d="M612 242 L824 232" stroke="#082b4a" stroke-width="3" stroke-linecap="round"/>
  <g fill="none" stroke="#082b4a" stroke-opacity=".6" stroke-width="1.5">
    <path d="M656 400 V372 Q656 364 664 362 L684 346 Q690 340 700 340 H748 Q758 340 764 348 L776 362 Q784 364 784 372 V400 Z" fill="#f4f8fb"/>
    <circle cx="684" cy="402" r="10" fill="#ffffff"/>
    <circle cx="756" cy="402" r="10" fill="#ffffff"/>
    <path d="M690 350 H742 L752 362 H682 Z" fill="#dcefff"/>
  </g>
</svg>
