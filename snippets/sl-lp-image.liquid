{%- comment -%}
  SICHERLUFT Landingpage-Kit: responsives Bild mit optionalem Zuschnitt über das Shopify-CDN.

  Das srcset wird bewusst manuell aufgebaut, damit der Zuschnitt (crop: 'region') in jeder
  Breite erhalten bleibt. width/height entsprechen dem Zuschnitt → kein Layout-Shift (CLS).
  Ist das Bild schmaler als die größte gewünschte Breite, wird es zusätzlich in voller Breite angeboten.

  Accepts:
  - image: {Object} Bild aus einem image_picker (Pflicht)
  - crop: {String} 'none' | 'left_half' | 'right_half' | 'left_upper' | 'region' (optional)
  - region: {String} nur bei crop 'region': Ausschnitt in Promille des Bildes, 'links,oben,breite,höhe',
            z. B. '146,98,234,371' (optional)
  - widths: {String} kommagetrennte Breiten, z. B. '360,540,720,960' (optional)
  - sizes: {String} sizes-Attribut (optional)
  - loading: {String} 'lazy' | 'eager' (Standard 'lazy')
  - priority: {Boolean} true setzt fetchpriority="high" (nur für das wichtigste Hero-Bild)
  - alt: {String} Alternativtext (Standard image.alt)
  - class: {String} CSS-Klasse (optional)
  - position: {String} object-position, z. B. image.presentation.focal_point (optional)
{%- endcomment -%}
{%- if image != blank -%}
  {%- liquid
    assign img_w = image.width
    assign img_h = image.height
    assign crop_mode = crop | default: 'none'
    assign crop_left = 0
    assign crop_top = 0
    assign crop_width = img_w
    assign crop_height = img_h
    case crop_mode
      when 'left_half'
        assign crop_width = img_w | divided_by: 2
      when 'right_half'
        assign crop_width = img_w | divided_by: 2
        assign crop_left = img_w | minus: crop_width
      when 'left_upper'
        assign crop_width = img_w | divided_by: 2
        assign crop_height = img_h | times: 70 | divided_by: 100
      when 'region'
        assign region_parts = region | default: '0,0,1000,1000' | split: ','
        assign r_left = region_parts[0] | strip | plus: 0
        assign r_top = region_parts[1] | strip | plus: 0
        assign r_width = region_parts[2] | strip | plus: 0
        assign r_height = region_parts[3] | strip | plus: 0
        assign crop_left = img_w | times: r_left | divided_by: 1000
        assign crop_top = img_h | times: r_top | divided_by: 1000
        assign crop_width = img_w | times: r_width | divided_by: 1000
        assign crop_height = img_h | times: r_height | divided_by: 1000
    endcase

    assign width_list = widths | default: '360,540,720,960' | split: ','
    assign srcset = ''
    assign src_url = ''
    assign largest = 0
    assign skipped = false
    for w_str in width_list
      assign w = w_str | strip | plus: 0
      if w > crop_width
        assign skipped = true
        continue
      endif
      if crop_mode == 'none'
        assign url = image | image_url: width: w
      else
        assign url = image | image_url: width: w, crop: 'region', crop_left: crop_left, crop_top: crop_top, crop_width: crop_width, crop_height: crop_height
      endif
      assign srcset = srcset | append: url | append: ' ' | append: w | append: 'w, '
      assign src_url = url
      assign largest = w
    endfor

    if skipped and largest < crop_width or src_url == blank
      if crop_mode == 'none'
        assign src_url = image | image_url: width: crop_width
      else
        assign src_url = image | image_url: width: crop_width, crop: 'region', crop_left: crop_left, crop_top: crop_top, crop_width: crop_width, crop_height: crop_height
      endif
      assign srcset = srcset | append: src_url | append: ' ' | append: crop_width | append: 'w, '
    endif

    assign srcset_length = srcset | size | minus: 2
    if srcset_length > 0
      assign srcset = srcset | slice: 0, srcset_length
    endif

    assign alt_text = alt | default: image.alt
  -%}
  <img
    src="{{ src_url }}"
    {% if srcset != blank %}srcset="{{ srcset }}"{% endif %}
    sizes="{{ sizes | default: '100vw' }}"
    width="{{ crop_width }}"
    height="{{ crop_height }}"
    alt="{{ alt_text | escape }}"
    loading="{{ loading | default: 'lazy' }}"
    decoding="async"
    {% if priority %}fetchpriority="high"{% endif %}
    {% if class != blank %}class="{{ class }}"{% endif %}
    {% if position != blank %}style="object-position: {{ position | escape }};"{% endif %}
  >
{%- endif -%}
