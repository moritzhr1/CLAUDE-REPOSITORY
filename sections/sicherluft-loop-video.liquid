{% comment %}
  SICHERLUFT Loop Video
  Seamless, silent looping animation rendered as a page element (not a player).
  Deliberately uses the plain, widely supported pattern for inline background
  video on iOS: a static <video autoplay muted loop playsinline> with the MP4
  source in the markup. No JS-injected sources and no hidden media-control
  pseudo-elements, both of which can stop iOS Safari from autoplaying.
{% endcomment %}

{%- liquid
  assign video = section.settings.video
  assign sid = section.id
-%}

<style>
  #shopify-section-{{ sid }} .sl-loop {
    {%- if section.settings.background != blank %}
    background: {{ section.settings.background }};
    {%- endif %}
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ sid }} .sl-loop__frame {
    width: 100%;
    max-width: {{ section.settings.max_width_desktop }}px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
  }

  #shopify-section-{{ sid }} .sl-loop__video {
    display: block;
    width: 100%;
    height: auto;
    {%- if video != blank and video.aspect_ratio %}
    aspect-ratio: {{ video.aspect_ratio }};
    {%- else %}
    aspect-ratio: 16 / 9;
    {%- endif %}
    object-fit: cover;
    border: 0;
    background: transparent;
    pointer-events: none;
  }

  /* Only the large iOS start-playback overlay is hidden. */
  #shopify-section-{{ sid }} .sl-loop__video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ sid }} .sl-loop {
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_horizontal_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ sid }} .sl-loop__frame {
      max-width: {{ section.settings.max_width_mobile }}px;
    }
  }
</style>

{%- if video != blank -%}
  {%- liquid
    assign mp4_sources = video.sources | where: 'format', 'mp4' | sort: 'height'
    assign source = mp4_sources | last
    for s in mp4_sources
      if s.height >= 720
        assign source = s
        break
      endif
    endfor

    assign poster_url = video.preview_image | image_url: width: 1280
    if section.settings.poster != blank
      assign poster_url = section.settings.poster | image_url: width: 1280
    endif
    assign label = section.settings.accessible_label | default: video.alt
  -%}

  <div class="sl-loop">
    <div class="sl-loop__frame">
      <video
        id="SlLoopVideo-{{ sid }}"
        class="sl-loop__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        disablepictureinpicture
        disableremoteplayback
        tabindex="-1"
        poster="{{ poster_url }}"
        width="{{ source.width | default: 1280 }}"
        height="{{ source.height | default: 720 }}"
        {% if label != blank %}aria-label="{{ label | escape }}" role="img"{% else %}aria-hidden="true"{% endif %}
      >
        <source src="{{ source.url }}" type="{{ source.mime_type | default: 'video/mp4' }}">
      </video>
    </div>
  </div>

  <script>
    (function () {
      var v = document.getElementById('SlLoopVideo-{{ sid }}');
      if (!v) return;
      v.muted = true;
      v.defaultMuted = true;
      v.playsInline = true;

      function tryPlay() {
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      }

      // If iOS refused autoplay (e.g. Low Power Mode), start on the next tap or click.
      var events = ['touchend', 'click'];
      function onGesture() {
        if (!v.paused) return done();
        var p = v.play();
        if (p && p.then) p.then(done, function () {});
      }
      function done() {
        events.forEach(function (type) {
          document.removeEventListener(type, onGesture, true);
        });
      }
      events.forEach(function (type) {
        document.addEventListener(type, onGesture, { capture: true, passive: true });
      });

      if (v.readyState >= 2) tryPlay();
      v.addEventListener('loadeddata', tryPlay, { once: true });
      v.addEventListener('playing', done, { once: true });
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="sl-loop">
    <div class="sl-loop__frame">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "SICHERLUFT Loop Video",
  "tag": "section",
  "class": "section-sicherluft-loop-video",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Loop video",
      "info": "Upload the MP4 to Shopify. It plays silently and loops seamlessly, without controls."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image (optional)",
      "info": "Shown before the video starts. Defaults to the video's preview frame."
    },
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible description (optional)",
      "info": "Read by screen readers. Leave empty to treat the animation as purely decorative."
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "max_width_desktop",
      "min": 320,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Max width (desktop)",
      "default": 640
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "min": 240,
      "max": 750,
      "step": 10,
      "unit": "px",
      "label": "Max width (mobile)",
      "default": 750
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Side spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Side spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background (optional)",
      "info": "Leave empty for transparent. Set it to the video's background colour to blend the edges into the page."
    }
  ],
  "presets": [
    {
      "name": "SICHERLUFT Loop Video"
    }
  ]
}
{% endschema %}
