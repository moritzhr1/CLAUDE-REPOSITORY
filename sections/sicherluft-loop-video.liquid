{% comment %}
  SICHERLUFT Loop Video
  Seamless, silent looping animation rendered as a page element (not a player).
  - Shopify-hosted video picked in the Theme Editor
  - Lazy: no video bytes are fetched until the section approaches the viewport
  - Picks the smallest MP4 rendition that is sharp enough for the rendered size
  - Pauses while off-screen, hides every native control / play-button overlay
{% endcomment %}

{%- liquid
  assign video = section.settings.video
  assign sid = section.id
-%}

<style>
  #shopify-section-{{ sid }} .sl-loop {
    --sl-loop-max-width: {{ section.settings.max_width }}px;
    --sl-loop-pt: {{ section.settings.padding_top }}px;
    --sl-loop-pb: {{ section.settings.padding_bottom }}px;
    --sl-loop-px: {{ section.settings.padding_horizontal }}px;
    --sl-loop-radius: {{ section.settings.border_radius }}px;
    {%- if video != blank and video.aspect_ratio %}
    --sl-loop-ratio: {{ video.aspect_ratio }};
    {%- else %}
    --sl-loop-ratio: 1.7778;
    {%- endif %}
    {%- if section.settings.background != blank %}
    background: {{ section.settings.background }};
    {%- endif %}
    padding: var(--sl-loop-pt) var(--sl-loop-px) var(--sl-loop-pb);
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ sid }} .sl-loop {
      --sl-loop-max-width: {{ section.settings.max_width_mobile }}px;
      --sl-loop-pt: {{ section.settings.padding_top_mobile }}px;
      --sl-loop-pb: {{ section.settings.padding_bottom_mobile }}px;
      --sl-loop-px: {{ section.settings.padding_horizontal_mobile }}px;
    }
  }

  #shopify-section-{{ sid }} .sl-loop__frame {
    display: block;
    position: relative;
    width: 100%;
    max-width: var(--sl-loop-max-width);
    margin: 0 auto;
    aspect-ratio: var(--sl-loop-ratio);
    overflow: hidden;
    border-radius: var(--sl-loop-radius);
    /* Reserve exact space up front: no layout shift while the video loads. */
    contain: layout paint;
  }

  #shopify-section-{{ sid }} .sl-loop__frame > video,
  #shopify-section-{{ sid }} .sl-loop__frame > img,
  #shopify-section-{{ sid }} .sl-loop__frame > svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    outline: 0;
    background: transparent;
    /* Decorative element: never interactive, never selectable. */
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Hide all native player chrome, including the iOS / Low Power Mode play overlay. */
  #shopify-section-{{ sid }} video::-webkit-media-controls,
  #shopify-section-{{ sid }} video::-webkit-media-controls-panel,
  #shopify-section-{{ sid }} video::-webkit-media-controls-play-button,
  #shopify-section-{{ sid }} video::-webkit-media-controls-start-playback-button,
  #shopify-section-{{ sid }} video::-webkit-media-controls-overlay-play-button,
  #shopify-section-{{ sid }} video::-webkit-media-controls-enclosure {
    display: none !important;
    opacity: 0 !important;
    -webkit-appearance: none;
  }
</style>

{%- if video != blank -%}
  {%- liquid
    assign mp4_sources = video.sources | where: 'format', 'mp4' | sort: 'height'
    assign poster_url = video.preview_image | image_url: width: 1280
    if section.settings.poster != blank
      assign poster_url = section.settings.poster | image_url: width: 1280
    endif
    assign label = section.settings.accessible_label | default: video.alt
  -%}

  <div class="sl-loop">
    <sicherluft-loop-video
      class="sl-loop__frame"
      data-reduced-motion="{{ section.settings.respect_reduced_motion }}"
    >
      <video
        muted
        loop
        playsinline
        webkit-playsinline
        autoplay
        preload="none"
        disablepictureinpicture
        disableremoteplayback
        controlslist="nodownload nofullscreen noremoteplayback noplaybackrate"
        tabindex="-1"
        poster="{{ poster_url }}"
        width="{{ video.preview_image.width | default: 1920 }}"
        height="{{ video.preview_image.height | default: 1080 }}"
        {% if label != blank %}aria-label="{{ label | escape }}" role="img"{% else %}aria-hidden="true"{% endif %}
      ></video>
      <script type="application/json" data-sources>
        [
          {%- for source in mp4_sources -%}
            {"url": {{ source.url | json }}, "height": {{ source.height | default: 0 }}, "type": {{ source.mime_type | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
      <noscript>
        {{ video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1280x' }}
      </noscript>
    </sicherluft-loop-video>
  </div>

  <script>
    (function () {
      if (customElements.get('sicherluft-loop-video')) return;

      class SicherluftLoopVideo extends HTMLElement {
        connectedCallback() {
          this.video = this.querySelector('video');
          if (!this.video) return;

          // Belt and braces for iOS: properties, not just attributes, must be set
          // for inline muted autoplay to be honoured.
          this.video.muted = true;
          this.video.defaultMuted = true;
          this.video.playsInline = true;
          this.video.controls = false;

          var reduce = this.dataset.reducedMotion === 'true' &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduce) {
            // Show the poster frame only; nothing is downloaded.
            this.video.removeAttribute('autoplay');
            return;
          }

          if (!('IntersectionObserver' in window)) {
            this.load();
            return;
          }

          this.observer = new IntersectionObserver(this.onIntersect.bind(this), {
            rootMargin: '300px 0px'
          });
          this.observer.observe(this);
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
          if (this.retry) document.removeEventListener('touchstart', this.retry);
        }

        onIntersect(entries) {
          var entry = entries[0];
          if (entry.isIntersecting) {
            if (!this.loaded) this.load();
            else this.play();
          } else if (this.loaded) {
            this.video.pause();
          }
        }

        pickSource() {
          var sources = [];
          try {
            sources = JSON.parse(this.querySelector('[data-sources]').textContent);
          } catch (e) {}
          if (!sources.length) return null;

          // Smallest rendition whose height covers the rendered size (DPR capped at 2).
          var conn = navigator.connection || {};
          var dpr = Math.min(window.devicePixelRatio || 1, 2);
          var needed = this.clientHeight * dpr;
          if (conn.saveData) return sources[0];

          for (var i = 0; i < sources.length; i++) {
            if (sources[i].height >= needed * 0.9) return sources[i];
          }
          return sources[sources.length - 1];
        }

        load() {
          var source = this.pickSource();
          if (!source) return;
          this.loaded = true;
          this.video.preload = 'auto';
          this.video.src = source.url;
          this.play();
        }

        play() {
          var self = this;
          var p = this.video.play();
          if (p && p.catch) {
            p.catch(function () {
              // Autoplay refused (e.g. iOS Low Power Mode). Poster stays visible
              // with no play button; retry on the first touch anywhere.
              if (self.retry) return;
              self.retry = function () {
                document.removeEventListener('touchstart', self.retry);
                self.retry = null;
                self.video.play().catch(function () {});
              };
              document.addEventListener('touchstart', self.retry, { passive: true, once: true });
            });
          }
        }
      }

      customElements.define('sicherluft-loop-video', SicherluftLoopVideo);
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="sl-loop">
    <div class="sl-loop__frame">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "SICHERLUFT Loop Video",
  "tag": "section",
  "class": "section-sicherluft-loop-video",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Loop video",
      "info": "Upload the MP4 to Shopify. It plays silently and loops seamlessly, without controls."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image (optional)",
      "info": "Shown before the video loads. Defaults to the video's preview frame. Use the first frame of the loop for an invisible start."
    },
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible description (optional)",
      "info": "Read by screen readers. Leave empty to treat the animation as purely decorative."
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 320,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "label": "Max width (desktop)",
      "default": 1100
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "min": 240,
      "max": 750,
      "step": 10,
      "unit": "px",
      "label": "Max width (mobile)",
      "default": 750
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Side spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Side spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background (optional)",
      "info": "Leave empty for transparent. Set it to the video's background colour to blend the edges into the page."
    },
    {
      "type": "checkbox",
      "id": "respect_reduced_motion",
      "label": "Respect reduced-motion setting",
      "info": "Visitors who turned on reduced motion see the still poster instead of the animation.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "SICHERLUFT Loop Video"
    }
  ]
}
{% endschema %}
