{%- comment -%}
  SICHERLUFT Landingpage-Kit · Hero
  Enthält das einzige h1 der Seite. Mobile-first: Botschaft und CTA stehen oben,
  die Visualisierung (Wohnmobil bei Nacht mit Blaulicht-Schein + echtes Gerät) folgt direkt darunter.

  A/B-Test des Hero-Buttons: Variante per URL-Parameter wählen, z. B. für verschiedene Anzeigen:
    /pages/wohnmobil-nacht-check?sl_cta=b   → Beschriftung/Ziel „Variante B“
    /pages/wohnmobil-nacht-check?sl_cta=c   → Beschriftung/Ziel „Variante C“
  Ohne Parameter gilt Variante A. Die Variante wird allen Tracking-Events als sl_variant mitgegeben.

  BILDMOTIV (optional, „Szenenfoto“): Wohnmobil nachts auf einem Stellplatz, warmes Licht im Innenraum,
  kalte blaue Umgebung, gern mit unscharfen Blaulicht-Reflexen im Hintergrund. Keine Personen in Not,
  keine Logos/Aufschriften von Einsatzorganisationen. Ohne Foto wird eine Illustration gezeigt.
{%- endcomment -%}
{%- render 'sl-lp-assets' -%}
{%- comment -%}
  Überschriften im Landingpage-Kit nutzen die Theme-Überschriftenschrift in 700. Der Schnitt wird
  hier vorgeladen, damit das H1 ohne sichtbaren Schriftwechsel (Layout-Shift) erscheint.
{%- endcomment -%}
{%- assign sl_heading_font = settings.type_header_font | font_modify: 'weight', '700' -%}
{%- if sl_heading_font -%}
  {% comment %}theme-check-disable AssetPreload{% endcomment %}
  <link rel="preload" as="font" href="{{ sl_heading_font | font_url }}" type="font/woff2" crossorigin>
  {% comment %}theme-check-enable AssetPreload{% endcomment %}
{%- endif -%}
{%- liquid
  assign anchor = section.settings.anchor | default: 'start' | handleize
  assign has_scene_image = false
  if section.settings.scene_image != blank
    assign has_scene_image = true
  endif
-%}

<section
  id="{{ anchor }}"
  class="sl-lp sl-lp-hero sl-lp-hero--alarm"
  aria-labelledby="SlHeroHeading-{{ section.id }}"
  data-sl-section="hero"
  data-sl-view="hero"
  data-sl-page="{{ page.handle | default: template.suffix }}"
>
  <div class="sl-lp__container sl-lp-hero__grid">
    <div class="sl-lp-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sl-lp-hero__pill">
          <span class="sl-lp-hero__pulse" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {%- endif -%}
      <h1 id="SlHeroHeading-{{ section.id }}" class="sl-lp-hero__h1">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_accent != blank %}
          <span class="sl-lp-hero__accent">{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.subheading != blank -%}
        <p class="sl-lp-hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="sl-lp-hero__text sl-lp-rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="sl-lp-hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a
            href="{{ section.settings.cta_link | default: '#' | escape }}"
            id="sl-hero-cta"
            class="sl-lp-cta sl-lp-cta--signal sl-lp-cta--xl"
            data-sl-track="hero_cta_click"
            data-sl-label="{{ section.settings.cta_label | escape }}"
            {% if section.settings.cta_label_b != blank %}data-sl-label-b="{{ section.settings.cta_label_b | escape }}" data-sl-href-b="{{ section.settings.cta_link_b | default: section.settings.cta_link | escape }}"{% endif %}
            {% if section.settings.cta_label_c != blank %}data-sl-label-c="{{ section.settings.cta_label_c | escape }}" data-sl-href-c="{{ section.settings.cta_link_c | default: section.settings.cta_link | escape }}"{% endif %}
          >
            <span data-sl-cta-text>{{ section.settings.cta_label | escape }}</span>
            {%- render 'sl-lp-icon', name: 'arrow-down', size: 20 -%}
          </a>
          {%- if section.settings.cta_label_b != blank or section.settings.cta_label_c != blank -%}
            <script>
              (function () {
                var m = /[?&]sl_cta=([abc])\b/i.exec(window.location.search);
                if (!m) return;
                var v = m[1].toLowerCase();
                document.documentElement.setAttribute('data-sl-variant', v);
                var a = document.getElementById('sl-hero-cta');
                if (!a || v === 'a') return;
                var label = a.getAttribute('data-sl-label-' + v);
                var href = a.getAttribute('data-sl-href-' + v);
                if (label) {
                  a.querySelector('[data-sl-cta-text]').textContent = label;
                  a.setAttribute('data-sl-label', label);
                }
                if (href) a.setAttribute('href', href);
              })();
            </script>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a
            href="{{ section.settings.secondary_link | default: '#' | escape }}"
            id="sl-hero-trust"
            class="sl-lp-link sl-lp-link--light"
            data-sl-track="hero_trust_click"
            data-sl-label="{{ section.settings.secondary_label | escape }}"
          >
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
      {%- render 'sl-lp-trust', items: section.settings.trust_items, tone: 'light' -%}
    </div>

    <div class="sl-lp-hero__visual">
      <div class="sl-lp-scene{% if has_scene_image %} sl-lp-scene--photo{% endif %}">
        {%- if has_scene_image -%}
          {%- render 'sl-lp-image',
            image: section.settings.scene_image,
            widths: '480,720,960,1280',
            sizes: '(min-width: 990px) 560px, calc(100vw - 40px)',
            loading: 'eager',
            alt: section.settings.scene_alt,
            class: 'sl-lp-scene__img',
            position: section.settings.scene_image.presentation.focal_point
          -%}
        {%- else -%}
          {%- render 'sl-lp-camper-scene', uid: section.id -%}
        {%- endif -%}
        {%- if section.settings.bluelight -%}
          <span class="sl-lp-scene__flash sl-lp-scene__flash--a" aria-hidden="true"></span>
          <span class="sl-lp-scene__flash sl-lp-scene__flash--b" aria-hidden="true"></span>
        {%- endif -%}
        {%- if section.settings.scene_badge != blank -%}
          <span class="sl-lp-scene__badge">{{ section.settings.scene_badge | escape }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.device_image != blank -%}
        <figure class="sl-lp-devicecard{% if section.settings.alarm_ring %} sl-lp-devicecard--ring{% endif %}">
          <div class="sl-lp-devicecard__media">
            {%- render 'sl-lp-image',
              image: section.settings.device_image,
              crop: section.settings.device_crop,
              widths: '240,360,480,640',
              sizes: '(min-width: 990px) 220px, (min-width: 750px) 30vw, 36vw',
              loading: 'eager',
              priority: true,
              alt: section.settings.device_alt,
              class: 'sl-lp-devicecard__img'
            -%}
          </div>
          {%- if section.settings.device_note != blank -%}
            <figcaption class="sl-lp-devicecard__note">{{ section.settings.device_note | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- elsif request.design_mode -%}
        <div class="sl-lp-devicecard sl-lp-devicecard--empty" data-sl-unverified>
          {%- render 'sl-lp-devflag', reason: 'Produktfoto im Hero auswählen (echtes Gerät mit lesbarem Display)' -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP · Hero",
  "tag": "div",
  "class": "sl-lp-shopify-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Landingpage-Kit SICHERLUFT. Diese Section enthält das einzige H1 der Seite."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Sprungmarke (ID)",
      "default": "start",
      "info": "Ohne #. Wird für Links innerhalb der Seite verwendet."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Warnhinweis über der Überschrift",
      "default": "Unsichtbare Gefahr im Wohnmobil"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift (H1)",
      "default": "Kohlenmonoxid riechst du nicht."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Überschrift, zweite Zeile (Signalfarbe)",
      "default": "Wenn du es merkst, kann es zu spät sein."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterzeile"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primärer Button (Variante A)",
      "default": "Jetzt Nacht-Check starten"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Ziel primärer Button (A)",
      "default": "#nacht",
      "info": "Sprungmarke (z. B. #nacht) oder Pfad (z. B. /pages/…)."
    },
    {
      "type": "text",
      "id": "cta_label_b",
      "label": "Button Variante B (A/B-Test)",
      "info": "Aktiv mit ?sl_cta=b in der Anzeigen-URL."
    },
    {
      "type": "text",
      "id": "cta_link_b",
      "label": "Ziel Variante B"
    },
    {
      "type": "text",
      "id": "cta_label_c",
      "label": "Button Variante C (A/B-Test)",
      "info": "Aktiv mit ?sl_cta=c in der Anzeigen-URL."
    },
    {
      "type": "text",
      "id": "cta_link_c",
      "label": "Ziel Variante C"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Textlink",
      "default": "Warum das wichtig ist"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Ziel Textlink",
      "default": "#gefahr"
    },
    {
      "type": "textarea",
      "id": "trust_items",
      "label": "Vertrauens-Merkmale unter dem Button",
      "info": "Ein Merkmal pro Zeile, nur belegte Aussagen. Zeilen mit [CLAIM VERIFIZIEREN] erscheinen nur im Editor."
    },
    {
      "type": "header",
      "content": "Visualisierung"
    },
    {
      "type": "image_picker",
      "id": "device_image",
      "label": "Produktfoto (echtes Gerät)",
      "info": "Empfohlen: sicherluft-echtes-produktfoto-referenz.jpg mit Zuschnitt „Linke Hälfte“ – ohne Siegel, Badges oder Aussagen im Bild."
    },
    {
      "type": "select",
      "id": "device_crop",
      "label": "Zuschnitt Produktfoto",
      "options": [
        { "value": "none", "label": "Ganzes Bild" },
        { "value": "left_half", "label": "Linke Hälfte" },
        { "value": "right_half", "label": "Rechte Hälfte" },
        { "value": "left_upper", "label": "Linke Hälfte, obere 70 %" }
      ],
      "default": "left_half"
    },
    {
      "type": "text",
      "id": "device_alt",
      "label": "Alternativtext Produktfoto",
      "default": "SICHERLUFT Gas- und CO-Melder mit Display für CO, Gas, Temperatur und Luftfeuchtigkeit"
    },
    {
      "type": "text",
      "id": "device_note",
      "label": "Bildunterschrift",
      "default": "Display: CO · Gas · °C · %RH"
    },
    {
      "type": "checkbox",
      "id": "alarm_ring",
      "label": "Pulsierender Warnring um das Gerät",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bluelight",
      "label": "Blaulicht-Schein über der Szene",
      "default": true,
      "info": "Ruhiges Pulsieren (kein Stroboskop). Bei „Bewegung reduzieren“ statisch."
    },
    {
      "type": "image_picker",
      "id": "scene_image",
      "label": "Szenenfoto (optional)",
      "info": "Motiv: Wohnmobil nachts, warmes Licht innen, kalte blaue Umgebung. Keine Personen in Not, keine Logos von Einsatzorganisationen. Ohne Foto wird eine Illustration gezeigt."
    },
    {
      "type": "text",
      "id": "scene_alt",
      "label": "Alternativtext Szenenfoto"
    },
    {
      "type": "text",
      "id": "scene_badge",
      "label": "Kennzeichnung im Bild",
      "info": "z. B. „Symbolbild“ – empfohlen, wenn ein dramatisches Foto verwendet wird."
    }
  ],
  "presets": [
    {
      "name": "LP · Hero"
    }
  ]
}
{% endschema %}
