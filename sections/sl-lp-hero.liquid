{%- comment -%}
  SICHERLUFT Landingpage-Kit · Hero
  Enthält das einzige h1 der Seite. Mobile-first: Botschaft und CTA stehen oben,
  die Visualisierung (Wohnmobil bei Nacht + echtes Gerät) folgt direkt darunter.
{%- endcomment -%}
{%- render 'sl-lp-assets' -%}
{%- comment -%}
  Überschriften im Landingpage-Kit nutzen die Theme-Überschriftenschrift in 600. Der Schnitt wird
  hier vorgeladen, damit das H1 ohne sichtbaren Schriftwechsel (Layout-Shift) erscheint.
{%- endcomment -%}
{%- assign sl_heading_font = settings.type_header_font | font_modify: 'weight', '600' -%}
{%- if sl_heading_font -%}
  {% comment %}theme-check-disable AssetPreload{% endcomment %}
  <link rel="preload" as="font" href="{{ sl_heading_font | font_url }}" type="font/woff2" crossorigin>
  {% comment %}theme-check-enable AssetPreload{% endcomment %}
{%- endif -%}
{%- liquid
  assign anchor = section.settings.anchor | default: 'start' | handleize
  assign has_scene_image = false
  if section.settings.scene_image != blank
    assign has_scene_image = true
  endif
-%}

<section
  id="{{ anchor }}"
  class="sl-lp sl-lp-hero sl-lp--night"
  aria-labelledby="SlHeroHeading-{{ section.id }}"
  data-sl-section="hero"
  data-sl-view="hero"
  data-sl-page="{{ page.handle | default: template.suffix }}"
>
  <div class="sl-lp__container sl-lp-hero__grid">
    <div class="sl-lp-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sl-lp-eyebrow sl-lp-eyebrow--light">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="SlHeroHeading-{{ section.id }}" class="sl-lp-hero__h1">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="sl-lp-hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="sl-lp-hero__text sl-lp-rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="sl-lp-hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a
            href="{{ section.settings.cta_link | default: '#' | escape }}"
            id="sl-hero-cta"
            class="sl-lp-cta sl-lp-cta--accent"
            data-sl-track="hero_cta_click"
            data-sl-label="{{ section.settings.cta_label | escape }}"
          >
            <span>{{ section.settings.cta_label | escape }}</span>
            {%- render 'sl-lp-icon', name: 'arrow-down', size: 20 -%}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a
            href="{{ section.settings.secondary_link | default: '#' | escape }}"
            id="sl-hero-trust"
            class="sl-lp-link sl-lp-link--light"
            data-sl-track="hero_trust_click"
            data-sl-label="{{ section.settings.secondary_label | escape }}"
          >
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="sl-lp-hero__visual">
      <div class="sl-lp-scene{% if has_scene_image %} sl-lp-scene--photo{% endif %}">
        {%- if has_scene_image -%}
          {%- render 'sl-lp-image',
            image: section.settings.scene_image,
            widths: '480,720,960,1280',
            sizes: '(min-width: 990px) 560px, calc(100vw - 40px)',
            loading: 'eager',
            alt: section.settings.scene_alt,
            class: 'sl-lp-scene__img'
          -%}
        {%- else -%}
          {%- render 'sl-lp-camper-scene', uid: section.id -%}
        {%- endif -%}
      </div>

      {%- if section.settings.device_image != blank -%}
        <figure class="sl-lp-devicecard">
          <div class="sl-lp-devicecard__media">
            {%- render 'sl-lp-image',
              image: section.settings.device_image,
              crop: section.settings.device_crop,
              widths: '240,360,480,640',
              sizes: '(min-width: 990px) 220px, (min-width: 750px) 30vw, 36vw',
              loading: 'eager',
              priority: true,
              alt: section.settings.device_alt,
              class: 'sl-lp-devicecard__img'
            -%}
          </div>
          {%- if section.settings.device_note != blank -%}
            <figcaption class="sl-lp-devicecard__note">{{ section.settings.device_note | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- elsif request.design_mode -%}
        <div class="sl-lp-devicecard sl-lp-devicecard--empty" data-sl-unverified>
          {%- render 'sl-lp-devflag', reason: 'Produktfoto im Hero auswählen (echtes Gerät mit lesbarem Display)' -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP · Hero",
  "tag": "div",
  "class": "sl-lp-shopify-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Landingpage-Kit SICHERLUFT. Diese Section enthält das einzige H1 der Seite."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Sprungmarke (ID)",
      "default": "start",
      "info": "Ohne #. Wird für Links innerhalb der Seite verwendet."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "SICHERLUFT · Sicherheit im Wohnmobil"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift (H1)",
      "default": "Gas zu. Heizung an. Und die Luft?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterzeile",
      "default": "Der Nacht-Check, der auf vielen Wohnmobil-Checklisten fehlt."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Bevor du schlafen gehst, prüfst du Gas, Türen, Fenster und Strom. Aber weißt du auch, was die Luft in deinem Wohnmobil gerade macht?</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primärer Button",
      "default": "Nacht-Check starten"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Ziel primärer Button",
      "default": "#irrtuemer",
      "info": "Sprungmarke (z. B. #irrtuemer) oder Pfad (z. B. /pages/…)."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Vertrauens-Link",
      "default": "Warum SICHERLUFT?"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Ziel Vertrauens-Link",
      "default": "#so-funktioniert"
    },
    {
      "type": "header",
      "content": "Visualisierung"
    },
    {
      "type": "image_picker",
      "id": "device_image",
      "label": "Produktfoto (echtes Gerät)",
      "info": "Empfohlen: sicherluft-echtes-produktfoto-referenz.jpg mit Zuschnitt „Linke Hälfte“ – ohne Siegel, Badges oder Aussagen im Bild."
    },
    {
      "type": "select",
      "id": "device_crop",
      "label": "Zuschnitt Produktfoto",
      "options": [
        { "value": "none", "label": "Ganzes Bild" },
        { "value": "left_half", "label": "Linke Hälfte" },
        { "value": "right_half", "label": "Rechte Hälfte" },
        { "value": "left_upper", "label": "Linke Hälfte, obere 70 %" }
      ],
      "default": "left_half"
    },
    {
      "type": "text",
      "id": "device_alt",
      "label": "Alternativtext Produktfoto",
      "default": "SICHERLUFT Gas- und CO-Melder mit Display für CO, Gas, Temperatur und Luftfeuchtigkeit"
    },
    {
      "type": "text",
      "id": "device_note",
      "label": "Bildunterschrift",
      "default": "Display: CO · Gas · °C · %RH"
    },
    {
      "type": "image_picker",
      "id": "scene_image",
      "label": "Szenenfoto (optional)",
      "info": "Echtes Foto eines Wohnmobils am Abend. Ohne Foto wird eine schlichte Illustration gezeigt. Keine Notfall- oder Katastrophenmotive."
    },
    {
      "type": "text",
      "id": "scene_alt",
      "label": "Alternativtext Szenenfoto"
    }
  ],
  "presets": [
    {
      "name": "LP · Hero"
    }
  ]
}
{% endschema %}
