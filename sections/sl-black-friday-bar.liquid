{%- comment -%}
  SICHERLUFT Black-Friday-Banner (v2): kompakte Leiste über dem Header.
  Links Produktbild + "EARLY ACCESS / BLACK FRIDAY" + Angebots-Chip, rechts ein
  Flip-Countdown HH:MM:SS, der jeden Tag bis 0:00 Uhr (Europe/Berlin) läuft und
  dann neu startet, bis zum eingestellten Aktionsende.
  Sticky übernimmt HeaderBannerStack (sections/header.liquid).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign end_date = s.end_date | strip
  assign end_time = s.end_time | strip | default: '00:00'
  assign render_bar = s.enabled

  # Aktion vorbei und "ausblenden": schon serverseitig weglassen, damit die Leiste
  # nicht erst erscheint und dann verschwindet (2 Std. Puffer für Zeitzone/Caching).
  if render_bar and s.after_end == 'hide' and end_date contains '-'
    assign end_stamp = end_date | append: ' ' | append: end_time | append: ':00 +0100' | date: '%s' | plus: 0
    assign now_stamp = 'now' | date: '%s' | plus: 0
    if end_stamp > 0 and now_stamp > end_stamp
      assign seconds_over = now_stamp | minus: end_stamp
      if seconds_over > 7200
        assign render_bar = false
      endif
    endif
  endif

  assign offer_html = s.offer_text | escape
  if s.offer_highlight != blank
    assign highlight = s.offer_highlight | escape
    assign highlight_html = '<span class="slbf__hl">' | append: highlight | append: '</span>'
    assign offer_html = offer_html | replace_first: highlight, highlight_html
  endif

  assign bar_classes = 'slbf slbf--m-' | append: s.layout_mobile
  if s.effects_3d
    assign bar_classes = bar_classes | append: ' slbf--fx'
  endif
  if s.animate
    assign bar_classes = bar_classes | append: ' slbf--anim'
  endif
  unless s.image_mobile
    assign bar_classes = bar_classes | append: ' slbf--m-noimg'
  endunless
-%}

{%- if render_bar -%}
  <style>
    .slbf {
      --slbf-fs: var(--slbf-fs-d, 24px);
      --slbf-pad: var(--slbf-pad-d, 6px);
      --slbf-ch: calc(var(--slbf-fs) * 1.42);
      --slbf-cw: calc(var(--slbf-fs) * 1.6);
      --slbf-cf: calc(var(--slbf-fs) * 1.02);
      --slbf-img: calc(var(--slbf-fs) * 2.45);
      --slbf-muted: rgba(255, 255, 255, 0.7);
      --slbf-ex1: #0a6fb5;
      --slbf-ex2: #085892;
      --slbf-ex3: #06416d;
      --slbf-face: #d7eeff;
      --slbf-glow: rgba(7, 155, 248, 0.45);
      --slbf-glow-soft: rgba(7, 155, 248, 0.16);
      --slbf-card-top: #173b61;
      --slbf-card-bot: #0c2542;
      --slbf-card-edge: #05111f;
      --slbf-chip-top: #3fb4ff;
      --slbf-chip-bot: #0679c9;
      position: relative;
      display: block;
      overflow: hidden;
      isolation: isolate;
      background: var(--slbf-bg, #071b2f);
      color: var(--slbf-text, #ffffff);
      line-height: 1;
      text-transform: uppercase;
      -webkit-font-smoothing: antialiased;
      box-shadow: inset 0 -2px 0 var(--slbf-accent, #079bf8);
    }

    .slbf[hidden] {
      display: none !important;
    }

    @supports (color: color-mix(in srgb, red 50%, white)) {
      .slbf {
        --slbf-muted: color-mix(in srgb, var(--slbf-text) 70%, transparent);
        --slbf-ex1: color-mix(in srgb, var(--slbf-accent) 72%, #000);
        --slbf-ex2: color-mix(in srgb, var(--slbf-accent) 56%, #000);
        --slbf-ex3: color-mix(in srgb, var(--slbf-accent) 40%, #000);
        --slbf-face: color-mix(in srgb, var(--slbf-text) 78%, var(--slbf-accent));
        --slbf-glow: color-mix(in srgb, var(--slbf-accent) 45%, transparent);
        --slbf-glow-soft: color-mix(in srgb, var(--slbf-accent) 16%, transparent);
        --slbf-card-top: color-mix(in srgb, var(--slbf-box) 86%, #fff);
        --slbf-card-bot: color-mix(in srgb, var(--slbf-box) 82%, #000);
        --slbf-card-edge: color-mix(in srgb, var(--slbf-box) 38%, #000);
        --slbf-chip-top: color-mix(in srgb, var(--slbf-accent) 74%, #fff);
        --slbf-chip-bot: color-mix(in srgb, var(--slbf-accent) 78%, #000);
      }
    }

    /* Hintergrund: Lichtkegel hinter Bild und Countdown, feine Diagonalen */
    .slbf::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      background:
        radial-gradient(ellipse 22% 140% at 9% 50%, var(--slbf-glow), transparent 70%),
        radial-gradient(ellipse 26% 160% at 88% 50%, var(--slbf-glow-soft), transparent 70%),
        repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 16px),
        linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 45%, rgba(0, 0, 0, 0.25));
    }

    /* Lichtreflex, der langsam über die Leiste wandert */
    .slbf::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: -1;
      width: 40%;
      pointer-events: none;
      background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.07) 50%, transparent 80%);
      transform: translateX(-120%);
      opacity: 0;
    }

    .slbf--anim::after {
      opacity: 1;
      animation: slbf-sheen 8s ease-in-out infinite;
    }

    @keyframes slbf-sheen {
      0%, 55% { transform: translateX(-120%); }
      100% { transform: translateX(300%); }
    }

    .slbf__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      max-width: var(--slbf-max, 1200px);
      margin: 0 auto;
      padding: var(--slbf-pad) 30px;
    }

    .slbf__deal {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    /* Produktbild: freigestellt, mit Kantenlicht und leichter 3D-Drehung */
    .slbf__media {
      position: relative;
      flex: 0 0 auto;
      height: var(--slbf-img);
      margin-block: calc(var(--slbf-pad) * -1 + 1px);
    }

    .slbf__media::before {
      content: '';
      position: absolute;
      inset: 18% 4% 6%;
      z-index: -1;
      border-radius: 50%;
      background: var(--slbf-glow);
      filter: blur(12px);
    }

    .slbf__img {
      display: block;
      width: auto;
      height: 100%;
      max-width: none;
      filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.5)) drop-shadow(0 4px 5px rgba(0, 0, 0, 0.55));
    }

    .slbf--fx .slbf__img {
      transform: perspective(420px) rotateY(-16deg) rotateZ(-3deg);
    }

    .slbf--anim .slbf__img {
      animation: slbf-float 4.5s ease-in-out infinite;
    }

    @keyframes slbf-float {
      0%, 100% { translate: 0 1px; }
      50% { translate: 0 -2px; }
    }

    .slbf__media--empty {
      display: flex;
      align-items: center;
      justify-content: center;
      width: calc(var(--slbf-img) * 0.9);
      border: 1px dashed var(--slbf-muted);
      border-radius: 6px;
      font-size: 9px;
      line-height: 1.2;
      text-align: center;
      text-transform: none;
      color: var(--slbf-muted);
    }

    .slbf__copy {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    .slbf .slbf__line {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin: 0;
      white-space: nowrap;
    }

    .slbf .slbf__eyebrow {
      font-size: calc(var(--slbf-fs) * 0.44);
      font-weight: 700;
      letter-spacing: 0.22em;
      color: var(--slbf-accent);
    }

    .slbf .slbf__headline {
      display: inline-block;
      font-size: var(--slbf-fs);
      font-weight: 800;
      letter-spacing: 0.015em;
      color: var(--slbf-text);
    }

    /* 3D-Schrift: Verlauf auf der Fläche, Extrusion über gestapelte Schatten */
    .slbf--fx .slbf__headline {
      padding-bottom: 3px;
      background: linear-gradient(180deg, var(--slbf-text) 30%, var(--slbf-face) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 1px 0 var(--slbf-ex1)) drop-shadow(0 1px 0 var(--slbf-ex2))
        drop-shadow(0 1px 0 var(--slbf-ex3)) drop-shadow(0 3px 4px rgba(0, 0, 0, 0.6));
    }

    /* Angebots-Chip */
    .slbf .slbf__chip {
      display: inline-block;
      flex: 0 0 auto;
      padding: 5px 10px 4px;
      border-radius: 7px;
      font-size: calc(var(--slbf-fs) * 0.5);
      font-weight: 700;
      letter-spacing: 0.06em;
      white-space: nowrap;
      color: #fff;
      background: var(--slbf-accent);
    }

    .slbf--fx .slbf__chip {
      background: linear-gradient(180deg, var(--slbf-chip-top), var(--slbf-accent) 55%, var(--slbf-chip-bot));
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.45),
        0 3px 0 var(--slbf-ex3),
        0 6px 14px var(--slbf-glow);
      text-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
      transform: perspective(300px) rotateX(8deg) rotate(-3deg);
    }

    .slbf .slbf__hl {
      font-size: 1.45em;
      font-weight: 800;
      vertical-align: -0.08em;
    }

    .slbf--fx .slbf__hl {
      text-shadow: 0 1px 0 var(--slbf-ex1), 0 2px 0 var(--slbf-ex3), 0 3px 4px rgba(0, 0, 0, 0.35);
    }

    /* Countdown */
    .slbf__timer {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 0 0 auto;
    }

    .slbf .slbf__label {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: calc(var(--slbf-fs) * 0.46);
      font-weight: 700;
      letter-spacing: 0.18em;
      white-space: nowrap;
      color: var(--slbf-muted);
    }

    .slbf__dot {
      flex: 0 0 auto;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--slbf-accent);
      box-shadow: 0 0 0 0 var(--slbf-glow);
    }

    .slbf--anim .slbf__dot {
      animation: slbf-pulse 2s ease-out infinite;
    }

    @keyframes slbf-pulse {
      0% { box-shadow: 0 0 0 0 var(--slbf-glow); }
      70%, 100% { box-shadow: 0 0 0 5px transparent; }
    }

    .slbf__clock {
      display: flex;
      align-items: flex-start;
      gap: 5px;
    }

    .slbf__unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
    }

    /* Flip-Karte: zwei feste Hälften + zwei Klappen, die beim Wechsel umschlagen */
    .slbf__card {
      position: relative;
      display: block;
      width: var(--slbf-cw);
      height: var(--slbf-ch);
      border-radius: 6px;
      background: var(--slbf-card-edge);
      color: var(--slbf-digit, #fff);
      font-size: var(--slbf-cf);
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      perspective: 180px;
    }

    .slbf--fx .slbf__card {
      box-shadow:
        0 1px 0 var(--slbf-card-edge),
        0 2px 0 var(--slbf-card-edge),
        0 3px 0 #02080f,
        0 6px 10px rgba(0, 0, 0, 0.5);
    }

    .slbf__half,
    .slbf__leaf {
      position: absolute;
      left: 0;
      right: 0;
      height: calc(50% - 0.5px);
      overflow: hidden;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }

    .slbf__half--top,
    .slbf__leaf--top {
      top: 0;
      border-radius: 6px 6px 0 0;
      background: linear-gradient(180deg, var(--slbf-card-top), var(--slbf-box, #0e2d4b));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
      transform-origin: 50% 100%;
    }

    .slbf__half--bot,
    .slbf__leaf--bot {
      bottom: 0;
      border-radius: 0 0 6px 6px;
      background: linear-gradient(180deg, var(--slbf-box, #0e2d4b), var(--slbf-card-bot));
      transform-origin: 50% 0;
    }

    .slbf__num {
      display: block;
      height: var(--slbf-ch);
      line-height: var(--slbf-ch);
      text-align: center;
      text-shadow: 0 1px 0 rgba(0, 0, 0, 0.4);
    }

    .slbf__half--bot .slbf__num,
    .slbf__leaf--bot .slbf__num {
      margin-top: calc(var(--slbf-ch) / -2);
    }

    /* Scharnierstifte links und rechts */
    .slbf__card::before,
    .slbf__card::after {
      content: '';
      position: absolute;
      top: 50%;
      z-index: 3;
      width: 3px;
      height: 6px;
      margin-top: -3px;
      border-radius: 1px;
      background: var(--slbf-card-edge);
    }

    .slbf__card::before {
      left: -1px;
    }

    .slbf__card::after {
      right: -1px;
    }

    .slbf__leaf {
      z-index: 2;
      display: none;
    }

    .slbf__card.is-flipping .slbf__leaf {
      display: block;
    }

    .slbf__card.is-flipping .slbf__leaf--top {
      animation: slbf-fold 0.28s ease-in forwards;
    }

    .slbf__card.is-flipping .slbf__leaf--bot {
      animation: slbf-unfold 0.28s ease-out 0.28s both;
    }

    @keyframes slbf-fold {
      from { transform: rotateX(0deg); filter: brightness(1); }
      to { transform: rotateX(-90deg); filter: brightness(0.6); }
    }

    @keyframes slbf-unfold {
      from { transform: rotateX(90deg); filter: brightness(1.5); }
      to { transform: rotateX(0deg); filter: brightness(1); }
    }

    .slbf .slbf__cap {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: var(--slbf-muted);
    }

    .slbf .slbf__sep {
      height: var(--slbf-ch);
      line-height: var(--slbf-ch);
      font-size: calc(var(--slbf-cf) * 0.9);
      font-weight: 800;
      color: var(--slbf-accent);
      text-shadow: 0 0 8px var(--slbf-glow);
    }

    .slbf__sr {
      position: absolute !important;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    @media screen and (max-width: 749px) {
      .slbf {
        --slbf-fs: var(--slbf-fs-m, 15px);
        --slbf-pad: var(--slbf-pad-m, 6px);
        --slbf-ch: calc(var(--slbf-fs) * 1.62);
        --slbf-cw: calc(var(--slbf-fs) * 1.72);
        --slbf-cf: calc(var(--slbf-fs) * 1.08);
        --slbf-img: calc(var(--slbf-fs) * 3.4);
      }

      .slbf__inner {
        gap: 10px;
        padding: var(--slbf-pad) 12px;
      }

      .slbf__deal {
        gap: 10px;
      }

      .slbf__copy {
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
      }

      .slbf .slbf__line {
        gap: 2px;
      }

      .slbf .slbf__eyebrow {
        font-size: calc(var(--slbf-fs) * 0.56);
        letter-spacing: 0.18em;
      }

      .slbf .slbf__chip {
        padding: 3px 7px 2px;
        border-radius: 5px;
        font-size: calc(var(--slbf-fs) * 0.6);
        letter-spacing: 0.04em;
      }

      .slbf--fx .slbf__chip {
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45), 0 2px 0 var(--slbf-ex3), 0 4px 10px var(--slbf-glow);
        transform: rotate(-2deg);
        margin-left: 1px;
      }

      .slbf__timer {
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }

      .slbf .slbf__label {
        gap: 5px;
        font-size: 8px;
        letter-spacing: 0.14em;
      }

      .slbf__dot {
        width: 5px;
        height: 5px;
      }

      .slbf__clock {
        gap: 3px;
      }

      .slbf__unit {
        gap: 4px;
      }

      .slbf .slbf__cap {
        font-size: 7.5px;
        letter-spacing: 0.12em;
      }

      .slbf__card {
        border-radius: 4px;
        perspective: 120px;
      }

      .slbf__half--top,
      .slbf__leaf--top {
        border-radius: 4px 4px 0 0;
      }

      .slbf__half--bot,
      .slbf__leaf--bot {
        border-radius: 0 0 4px 4px;
      }

      .slbf--m-noimg .slbf__media {
        display: none;
      }

      /* Gestapelt: Angebot oben, Countdown darunter (beides zentriert) */
      .slbf--m-stacked .slbf__inner {
        flex-direction: column;
        gap: 6px;
      }

      .slbf--m-stacked .slbf__copy {
        flex-direction: row;
        align-items: center;
      }

      .slbf--m-stacked .slbf__timer {
        flex-direction: row;
        gap: 10px;
      }

      .slbf--m-stacked .slbf__media {
        --slbf-img: calc(var(--slbf-fs) * 2.4);
      }
    }

    @media screen and (max-width: 359px) {
      .slbf__inner {
        padding-inline: 8px;
      }

      .slbf--m-row .slbf__media {
        --slbf-img: calc(var(--slbf-fs) * 2.9);
      }

      .slbf--m-row .slbf__chip {
        letter-spacing: 0.02em;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .slbf--anim::after,
      .slbf--anim .slbf__img,
      .slbf--anim .slbf__dot,
      .slbf__card.is-flipping .slbf__leaf {
        animation: none;
      }

      .slbf__card.is-flipping .slbf__leaf {
        display: none;
      }
    }
  </style>

  <sl-black-friday-bar
    class="{{ bar_classes }}"
    data-end-date="{{ end_date | escape }}"
    data-end-time="{{ end_time | escape }}"
    data-timezone="{{ s.timezone | escape }}"
    data-after-end="{{ s.after_end }}"
    data-label-h="{{ s.label_hours | escape }}"
    data-label-m="{{ s.label_minutes | escape }}"
    {% if s.animate %}
      data-animate="true"
    {% endif %}
    {% unless s.sticky %}
      data-header-stack="off"
    {% endunless %}
    style="--slbf-bg: {{ s.bg_color }}; --slbf-accent: {{ s.accent_color }}; --slbf-text: {{ s.text_color }}; --slbf-digit: {{ s.digit_color }}; --slbf-box: {{ s.box_color }}; --slbf-pad-d: {{ s.pad_desktop }}px; --slbf-pad-m: {{ s.pad_mobile }}px; --slbf-fs-d: {{ s.size_desktop }}px; --slbf-fs-m: {{ s.size_mobile }}px; --slbf-max: {{ s.max_width }}px;"
  >
    <div class="slbf__inner">
      <div class="slbf__deal">
        {%- if s.image != blank -%}
          <div class="slbf__media">
            {%- assign img_alt = s.image.alt | default: 'SICHERLUFT Gas- & CO-Melder' -%}
            {{
              s.image
              | image_url: width: 240
              | image_tag:
                widths: '80, 120, 160, 240',
                sizes: '(min-width: 750px) 56px, 48px',
                loading: 'eager',
                alt: img_alt,
                class: 'slbf__img'
            }}
          </div>
        {%- elsif request.design_mode -%}
          <div class="slbf__media slbf__media--empty">Bild wählen</div>
        {%- endif -%}

        <div class="slbf__copy">
          <p class="slbf__line">
            {%- if s.eyebrow != blank -%}
              <span class="slbf__eyebrow">{{ s.eyebrow | escape }}</span>
            {%- endif -%}
            {%- if s.headline != blank -%}
              <span class="slbf__headline">{{ s.headline | escape }}</span>
            {%- endif -%}
          </p>
          {%- if s.offer_text != blank -%}
            <span class="slbf__chip">{{ offer_html }}</span>
          {%- endif -%}
        </div>
      </div>

      {%- if s.show_countdown -%}
        <div class="slbf__timer" data-slbf-timer role="timer">
          {%- if s.label_timer != blank -%}
            <span class="slbf__label"><span class="slbf__dot" aria-hidden="true"></span>{{ s.label_timer | escape }}</span>
          {%- endif -%}
          <span class="slbf__clock" aria-hidden="true">
            {%- assign keys = 'h,m,s' | split: ',' -%}
            {%- for key in keys -%}
              {%- case key -%}
                {%- when 'h' -%}
                  {%- assign cap = s.label_hours -%}
                {%- when 'm' -%}
                  {%- assign cap = s.label_minutes -%}
                {%- else -%}
                  {%- assign cap = s.label_seconds -%}
              {%- endcase -%}
              <span class="slbf__unit">
                <span class="slbf__card" data-slbf="{{ key }}">
                  <span class="slbf__half slbf__half--top"><span class="slbf__num">--</span></span>
                  <span class="slbf__half slbf__half--bot"><span class="slbf__num">--</span></span>
                  <span class="slbf__leaf slbf__leaf--top"><span class="slbf__num">--</span></span>
                  <span class="slbf__leaf slbf__leaf--bot"><span class="slbf__num">--</span></span>
                </span>
                <span class="slbf__cap">{{ cap | escape }}</span>
              </span>
              {%- unless forloop.last -%}
                <span class="slbf__sep">:</span>
              {%- endunless -%}
            {%- endfor -%}
          </span>
          <span class="slbf__sr" data-slbf-sr></span>
        </div>
      {%- endif -%}
    </div>
  </sl-black-friday-bar>

  <script>
    (function () {
      if (window.customElements.get('sl-black-friday-bar')) return;

      // Wanduhrzeit einer Zeitzone (z. B. Europe/Berlin) in einen UTC-Zeitpunkt umrechnen.
      function zoneParts(ms, timeZone) {
        var parts = {};
        new Intl.DateTimeFormat('en-US', {
          timeZone: timeZone,
          hourCycle: 'h23',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
        })
          .formatToParts(new Date(ms))
          .forEach(function (part) {
            parts[part.type] = part.value;
          });
        return parts;
      }

      function zoneOffset(ms, timeZone) {
        var p = zoneParts(ms, timeZone);
        var wall = Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour % 24, +p.minute, +p.second);
        return wall - Math.floor(ms / 1000) * 1000;
      }

      function zoneToUtc(year, month, day, hour, minute, timeZone) {
        var wall = Date.UTC(year, month - 1, day, hour, minute, 0);
        var utc = wall - zoneOffset(wall, timeZone);
        return wall - zoneOffset(utc, timeZone);
      }

      function nextMidnight(now, timeZone) {
        var p = zoneParts(now, timeZone);
        var tomorrow = new Date(Date.UTC(+p.year, +p.month - 1, +p.day) + 86400000);
        return zoneToUtc(tomorrow.getUTCFullYear(), tomorrow.getUTCMonth() + 1, tomorrow.getUTCDate(), 0, 0, timeZone);
      }

      // Aktionsende: "2026-11-30" oder "30.11.2026", Uhrzeit "HH:MM" (sonst 00:00).
      function parseEnd(dateText, timeText, timeZone) {
        var y, mo, d;
        var iso = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(dateText);
        var de = /^(\d{1,2})\.(\d{1,2})\.(\d{4})$/.exec(dateText);
        if (iso) {
          y = +iso[1];
          mo = +iso[2];
          d = +iso[3];
        } else if (de) {
          y = +de[3];
          mo = +de[2];
          d = +de[1];
        } else {
          return NaN;
        }
        var t = /^(\d{1,2}):(\d{2})$/.exec(timeText) || [null, '0', '0'];
        return zoneToUtc(y, mo, d, +t[1], +t[2], timeZone);
      }

      function pad(value) {
        return value < 10 ? '0' + value : String(value);
      }

      class SlBlackFridayBar extends HTMLElement {
        connectedCallback() {
          if (!this.querySelector('[data-slbf-timer]')) return;

          this.timeZone = this.dataset.timezone || 'Europe/Berlin';
          try {
            this.end = parseEnd((this.dataset.endDate || '').trim(), (this.dataset.endTime || '').trim(), this.timeZone);
            nextMidnight(Date.now(), this.timeZone);
          } catch (error) {
            this.timeZone = 'Europe/Berlin';
            this.end = NaN;
          }

          var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          this.flip = this.dataset.animate === 'true' && !reduce;
          this.sr = this.querySelector('[data-slbf-sr]');
          this.cards = {};
          this.querySelectorAll('[data-slbf]').forEach(
            function (el) {
              var nums = el.querySelectorAll('.slbf__num');
              this.cards[el.getAttribute('data-slbf')] = {
                el: el,
                top: nums[0],
                bot: nums[1],
                leafTop: nums[2],
                leafBot: nums[3],
                value: null,
              };
            }.bind(this)
          );

          this.tick = this.tick.bind(this);
          this.tick();
        }

        disconnectedCallback() {
          clearTimeout(this.timeout);
          Object.keys(this.cards || {}).forEach(
            function (key) {
              clearTimeout(this.cards[key].timer);
            }.bind(this)
          );
        }

        tick() {
          var now = Date.now();

          // Aktion vorbei (falls ein Ende gesetzt ist)
          if (now >= this.end) {
            if (this.dataset.afterEnd === 'hide') {
              this.hidden = true;
              return;
            }
            this.render(0);
            return;
          }

          // Jeden Tag bis 0:00 Uhr, am letzten Tag nur bis zum Aktionsende
          var target = nextMidnight(now, this.timeZone);
          if (this.end < target) target = this.end;
          this.render(target - now);

          // Nächster Schritt genau zum Sekundenwechsel, damit die Karten im Takt umklappen
          this.timeout = setTimeout(this.tick, 1000 - (Date.now() % 1000) + 5);
        }

        render(left) {
          var total = Math.max(0, Math.floor(left / 1000));
          var hours = Math.floor(total / 3600);
          var minutes = Math.floor((total % 3600) / 60);
          this.set('h', hours);
          this.set('m', minutes);
          this.set('s', total % 60);

          var text = hours + ' ' + (this.dataset.labelH || 'Std') + ' ' + minutes + ' ' + (this.dataset.labelM || 'Min');
          if (this.sr && this.sr.textContent !== text) this.sr.textContent = text;
        }

        set(key, value) {
          var card = this.cards[key];
          if (!card) return;
          var text = pad(value);
          var old = card.value;
          if (old === text) return;
          card.value = text;

          if (old === null || !this.flip) {
            card.top.textContent = card.bot.textContent = card.leafTop.textContent = card.leafBot.textContent = text;
            return;
          }

          // Oben steht schon die neue Zahl, die obere Klappe (alt) fällt darüber nach vorn,
          // danach klappt die untere Klappe (neu) herunter und deckt die alte untere Hälfte ab.
          card.top.textContent = text;
          card.bot.textContent = old;
          card.leafTop.textContent = old;
          card.leafBot.textContent = text;
          card.el.classList.remove('is-flipping');
          void card.el.offsetWidth;
          card.el.classList.add('is-flipping');
          clearTimeout(card.timer);
          card.timer = setTimeout(function () {
            card.bot.textContent = card.value;
            card.el.classList.remove('is-flipping');
          }, 600);
        }
      }

      window.customElements.define('sl-black-friday-bar', SlBlackFridayBar);
    })();
  </script>
{%- elsif request.design_mode -%}
  <div style="padding: 6px 12px; font-size: 12px; text-align: center; background: #f3f6f9; color: #5b6b7c;">
    Black-Friday-Banner ist ausgeblendet{% if s.enabled %} (Aktion vorbei){% endif %}.
  </div>
{%- endif -%}

