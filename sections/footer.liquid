{% comment %} SICHERLUFT Footer – vollständig überarbeitet {% endcomment %}

{%- style -%}
  .sicherluft-footer {
    background: transparent;
    padding: 36px 0 28px;
    overflow-x: hidden;
  }

  .sicherluft-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .sicherluft-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sicherluft-footer__logo-img {
    width: 160px;
    height: auto;
    display: block;
  }

  .sicherluft-footer__shop-name {
    font-size: 20px;
    font-weight: var(--font-weight-bold, 700);
    color: #082B4A;
  }

  .sicherluft-footer__mission {
    margin: 10px 0 0;
    font-size: 14px;
    font-weight: 400;
    color: rgba(8, 43, 74, 0.7);
  }

  .sicherluft-footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 26px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .sicherluft-footer__nav-link {
    font-size: 14px;
    color: #082B4A;
    text-decoration: none;
    white-space: nowrap;
  }

  .sicherluft-footer__nav-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sicherluft-footer__divider {
    width: 100%;
    border: none;
    border-top: 1px solid rgba(8, 43, 74, 0.12);
    margin: 24px 0 0;
  }

  .sicherluft-footer__copy {
    margin: 20px 0 0;
    font-size: 12px;
    color: rgba(8, 43, 74, 0.6);
  }

  .sicherluft-footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 16px 0 0;
    padding-bottom: 25px;
  }

  .sicherluft-footer__payment-icon {
    height: 22px;
    width: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .sicherluft-footer {
      padding: 32px 0 26px;
    }

    .sicherluft-footer__logo-img {
      width: 135px;
    }

    .sicherluft-footer__nav {
      gap: 10px 18px;
      margin-top: 22px;
    }

    .sicherluft-footer__divider {
      margin-top: 20px;
    }

    .sicherluft-footer__copy {
      margin-top: 18px;
    }
  }
{%- endstyle -%}

<footer class="sicherluft-footer">
  <div class="sicherluft-footer__inner page-width">

    {%- comment -%} Logo + Mission {%- endcomment -%}
    <div class="sicherluft-footer__brand">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name }}"
          class="sicherluft-footer__logo-img"
          loading="lazy"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
        >
      {%- elsif settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name }}"
          class="sicherluft-footer__logo-img"
          loading="lazy"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
        >
      {%- else -%}
        <span class="sicherluft-footer__shop-name">{{ shop.name }}</span>
      {%- endif -%}
      <p class="sicherluft-footer__mission">Unsere Mission: Mehr Sicherheit für Ihr Zuhause.</p>
    </div>

    {%- comment -%} Navigation {%- endcomment -%}
    {%- if section.settings.menu != blank -%}
      {%- assign nav = linklists[section.settings.menu] -%}
      {%- if nav.links.size > 0 -%}
        <nav class="sicherluft-footer__nav" aria-label="Footer-Navigation">
          {%- for link in nav.links -%}
            <a href="{{ link.url }}" class="sicherluft-footer__nav-link">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Trennlinie {%- endcomment -%}
    <hr class="sicherluft-footer__divider">

    {%- comment -%} Copyright {%- endcomment -%}
    <p class="sicherluft-footer__copy">
      &copy; {{ 'now' | date: '%Y' }} Sicherluft. Alle Rechte vorbehalten.
    </p>

    {%- comment -%} Payment-Icons – immer als letztes Element im Footer {%- endcomment -%}
    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="sicherluft-footer__payment">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'sicherluft-footer__payment-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</footer>

{% schema %}
{
  "name": "Fußzeile",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (Footer)",
      "info": "Optional – wenn leer, wird das globale Shop-Logo verwendet."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigationsmenü",
      "default": "footer"
    }
  ]
}
{% endschema %}
