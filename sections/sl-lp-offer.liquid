{%- comment -%}
  SICHERLUFT Landingpage-Kit · Angebot
  Preise
  - Einzelpreis, Verfügbarkeit und ein evtl. gepflegter Vergleichspreis kommen live aus Shopify.
  - Set-Preise (2/3/4 Geräte) kommen aus dem Kaching-Deal „SICHERLUFT Mengenrabatt“ (automatischer
    Shopify-Rabatt mit Festpreis je Menge). Liquid kann die Kaching-Daten nicht lesen → Set-Preis je Block
    im Feld „Set-Preis“ pflegen. Streichpreis = Einzelpreis × Anzahl (so rechnet auch Kaching).
  - Kaching rabattiert eine Warenkorbzeile nur mit der Eigenschaft
    __kaching_bundles = {"deal":"<Deal-ID>","main":true} – dieselbe, die das Kaching-Widget auf der
    Produktseite setzt. Das Formular sendet sie, sobald „Kaching-Deal-ID“ gepflegt ist. Ohne Deal-ID zeigt
    die Seite reguläre Preise (Einzelpreis × Anzahl), damit Seite und Warenkorb nie auseinanderlaufen.
  - „Versandkostenfrei“ nur ab der im Theme hinterlegten Schwelle (Theme-Einstellungen → Cart Drawer →
    „Amount limit for free shipping“, passend zur Versandrate ab 80 €).
  - Warenkorb über das vorhandene <product-form> des Themes (AJAX, öffnet den Cart-Drawer).
    Ohne JavaScript funktioniert das Formular als normaler POST auf /cart/add.
  Technik: Der erste Durchlauf merkt sich je Block Status und Preise als Text
  (states: |blockid=status|, prices: |blockid=angebotspreis,streichpreis| in Cent).
  Stückpreis = kaufmännisch gerundet, nur mit ganzen Cent: (2 × Preis + Menge) ÷ (2 × Menge).
{%- endcomment -%}
{%- render 'sl-lp-assets' -%}
{%- liquid
  assign anchor = section.settings.anchor | default: 'angebot' | handleize
  assign track = section.settings.tracking_name | default: anchor | handleize
  assign heading_id = 'SlHeading-' | append: section.id
  assign form_id = 'SlOfferForm-' | append: section.id

  assign free_shipping_cents = 0
  if settings.product_free_shipping != blank
    assign free_shipping_cents = settings.product_free_shipping | times: 100
  endif

  assign deal_id = section.settings.kaching_deal | strip | remove: '"'
  assign bundle_active = false
  if deal_id != blank
    assign bundle_active = true
  endif
  assign bundle_prop = '{"deal":"' | append: deal_id | append: '","main":true}'

  assign states = '|'
  assign prices = '|'
  assign live_options = 0
  assign card_count = 0
  assign default_index = 0
  assign highlight_index = 0
  assign first_index = 0
  assign min_total = 0
  assign price_issue = ''
  for block in section.blocks
    if block.type != 'option'
      continue
    endif
    assign st = ''
    if block.settings.product == blank
      assign st = 'missing'
    else
      assign t = block.settings.title | append: ' ' | append: block.settings.subtitle | append: ' ' | append: block.settings.text | append: ' ' | append: block.settings.highlight_label | append: ' ' | append: block.settings.cta_label
      capture c
        render 'sl-lp-claim-check', text: t
      endcapture
      if c contains 'unverified'
        assign st = 'claim'
      endif
    endif
    assign states = states | append: block.id | append: '=' | append: st | append: '|'

    assign offer_total = 0
    assign compare_total = 0
    if block.settings.product != blank
      assign v = block.settings.product.selected_or_first_available_variant
      assign qty = block.settings.quantity
      assign regular_total = v.price | times: qty
      assign offer_total = regular_total
      if v.compare_at_price > v.price
        assign compare_total = v.compare_at_price | times: qty
      endif
      if block.settings.offer_price != blank
        if bundle_active
          assign parsed = block.settings.offer_price | remove: '€' | remove: ' ' | replace: ',', '.' | times: 100 | round
          if parsed > 0 and parsed < regular_total
            assign offer_total = parsed
            if compare_total < regular_total
              assign compare_total = regular_total
            endif
          else
            assign price_issue = price_issue | append: block.settings.title | append: ': Set-Preis ungültig oder nicht günstiger als Einzelpreis × Anzahl. '
          endif
        else
          assign price_issue = price_issue | append: block.settings.title | append: ': Set-Preis ignoriert, weil die Kaching-Deal-ID fehlt. '
        endif
      endif
    endif
    assign prices = prices | append: block.id | append: '=' | append: offer_total | append: ',' | append: compare_total | append: '|'

    if st == blank or request.design_mode and block.settings.product != blank
      if first_index == 0
        assign first_index = forloop.index
      endif
      if block.settings.preselected and default_index == 0
        assign default_index = forloop.index
      endif
      if block.settings.highlight and highlight_index == 0
        assign highlight_index = forloop.index
      endif
    endif
    if st == blank
      assign live_options = live_options | plus: 1
      if block.settings.display != 'compact'
        assign card_count = card_count | plus: 1
      endif
      if min_total == 0 or offer_total < min_total
        assign min_total = offer_total
      endif
    endif
  endfor
  if default_index == 0
    assign default_index = highlight_index
  endif
  if default_index == 0
    assign default_index = first_index
  endif
  if card_count < 1
    assign card_count = 1
  endif

  assign default_product = nil
  assign default_variant = nil
  assign default_title = ''
  assign default_total = 0
  for block in section.blocks
    if forloop.index == default_index
      assign default_product = block.settings.product
      assign default_variant = default_product.selected_or_first_available_variant
      assign default_title = block.settings.title
      assign key = '|' | append: block.id | append: '='
      assign default_total = prices | split: key | last | split: '|' | first | split: ',' | first | plus: 0
    endif
  endfor

  assign section_live = true
  if live_options == 0
    assign section_live = false
  endif
-%}

{%- if section_live or request.design_mode -%}
  <section
    id="{{ anchor }}"
    class="sl-lp sl-lp-offer sl-lp--{{ section.settings.background }} sl-lp--space-{{ section.settings.spacing }}{% unless section_live %} sl-lp--dev-hidden{% endunless %}"
    aria-labelledby="{{ heading_id }}"
    data-sl-section="{{ track }}"
    data-sl-view="{{ track }}"
    data-sl-offer-section
    {% unless section_live %}data-sl-unverified{% endunless %}
  >
    <div class="sl-lp__container">
      {%- unless section_live -%}{%- render 'sl-lp-devflag', reason: 'section', detail: 'kein Angebot mit Produkt hinterlegt' -%}{%- endunless -%}

      {%- render 'sl-lp-section-head',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        heading_id: heading_id,
        intro: section.settings.intro,
        align: 'center',
        size: section.settings.heading_size
      -%}

      {%- if request.design_mode and price_issue != blank -%}
        <p class="sl-lp-devnote sl-lp-devnote--block">{{ price_issue | escape }}</p>
      {%- endif -%}

      {%- if default_product != blank -%}
        <product-form class="sl-lp-offer__form" data-section-id="{{ section.id }}" data-hide-errors="false" data-sl-offer-form>
          <div class="product-form__error-message-wrapper sl-lp-offer__error" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>
          {%- form 'product', default_product, id: form_id, class: 'sl-lp-offer__formel', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ default_variant.id }}" data-sl-offer-variant>
            {%- if bundle_active -%}
              <input type="hidden" name="properties[__kaching_bundles]" value="{{ bundle_prop | escape }}">
            {%- endif -%}
            <fieldset class="sl-lp-offer__options" style="--sl-offer-cols: {{ card_count }};">
              <legend class="visually-hidden">{{ section.settings.legend | default: 'Anzahl der Geräte wählen' | escape }}</legend>
              {%- for block in section.blocks -%}
                {%- if block.type != 'option' -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign key = '|' | append: block.id | append: '='
                  assign st = states | split: key | last | split: '|' | first
                  if st == 'missing'
                    continue
                  endif
                  if st != blank
                    unless request.design_mode
                      continue
                    endunless
                  endif

                  assign s = block.settings
                  assign product = s.product
                  assign variant = product.selected_or_first_available_variant
                  assign qty = s.quantity
                  assign price_pair = prices | split: key | last | split: '|' | first | split: ','
                  assign total = price_pair[0] | plus: 0
                  assign compare_total = price_pair[1] | plus: 0
                  assign savings = 0
                  if compare_total > total
                    assign savings = compare_total | minus: total
                  endif
                  assign twice_qty = qty | times: 2
                  assign unit_price = total | times: 2 | plus: qty | divided_by: twice_qty
                  assign compact = false
                  if s.display == 'compact'
                    assign compact = true
                  endif

                  assign offer_id = s.offer_id | default: block.id | handleize
                  assign input_id = 'SlOffer-' | append: section.id | append: '-' | append: forloop.index
                  assign cta_label = s.cta_label | default: section.settings.cta_label
                  assign is_default = false
                  if forloop.index == default_index
                    assign is_default = true
                  endif
                  assign free_shipping = false
                  if free_shipping_cents > 0 and total >= free_shipping_cents
                    assign free_shipping = true
                  endif
                -%}
                <div
                  class="sl-lp-option{% if compact %} sl-lp-option--compact{% endif %}{% if s.highlight and compact == false %} sl-lp-option--highlight{% endif %}{% if s.highlight_label != blank and compact == false %} sl-lp-option--badge{% endif %}{% if is_default %} is-selected{% endif %}{% if st != blank %} sl-lp-card--dev-hidden{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if st != blank %}data-sl-unverified="{{ st }}"{% endif %}
                >
                  {%- if st != blank -%}{%- render 'sl-lp-devflag', reason: st -%}{%- endif -%}
                  {%- if s.highlight_label != blank and compact == false -%}
                    <p class="sl-lp-option__badge">{{ s.highlight_label | escape }}</p>
                  {%- endif -%}
                  <div class="sl-lp-option__top">
                    <input
                      type="radio"
                      id="{{ input_id }}"
                      class="sl-lp-option__radio"
                      name="quantity"
                      value="{{ qty }}"
                      {% if is_default %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                      data-variant-id="{{ variant.id }}"
                      data-sl-offer="{{ offer_id }}"
                      data-sl-qty="{{ qty }}"
                      data-sl-price="{{ total | money | strip_html | escape }}"
                      data-sl-price-cents="{{ total }}"
                      data-sl-cta-label="{{ cta_label | escape }}"
                      data-sl-option-title="{{ s.title | escape }}"
                    >
                    <label class="sl-lp-option__name" for="{{ input_id }}">
                      <span class="sl-lp-option__head">{{ s.title | escape }}</span>
                      {%- if s.subtitle != blank -%}
                        <span class="sl-lp-option__sub">{{ s.subtitle | escape }}</span>
                      {%- endif -%}
                    </label>
                  </div>

                  {%- if s.image != blank and compact == false -%}
                    <div class="sl-lp-option__media">
                      {%- render 'sl-lp-image', image: s.image, widths: '160,240,320,480', sizes: '(min-width: 990px) 200px, 30vw', alt: s.image_alt, class: 'sl-lp-option__img' -%}
                    </div>
                  {%- endif -%}

                  {%- if s.text != blank and compact == false -%}
                    <div class="sl-lp-option__text sl-lp-rte">{{ s.text }}</div>
                  {%- endif -%}

                  <div class="sl-lp-option__price">
                    <p class="sl-lp-option__total">
                      <span class="sl-lp-option__amount">{{ total | money }}</span>
                      {%- if savings > 0 -%}
                        <s class="sl-lp-option__compare"><span class="visually-hidden">Einzeln gekauft: </span>{{ compare_total | money }}</s>
                      {%- endif -%}
                    </p>
                    {%- if savings > 0 or qty > 1 -%}
                      <p class="sl-lp-option__deal">
                        {%- if savings > 0 -%}
                          <span class="sl-lp-option__save">{{ savings | money }} sparen</span>
                        {%- endif -%}
                        {%- if qty > 1 -%}
                          <span class="sl-lp-option__unit">{{ unit_price | money }} / Gerät</span>
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                    {%- unless compact -%}
                      <p class="sl-lp-option__legal">
                        {%- if cart.taxes_included -%}inkl. MwSt. · {% endif -%}
                        <span class="sl-lp-nowrap">
                          {%- if free_shipping -%}
                            {{ section.settings.free_shipping_text | default: 'versandkostenfrei (DE)' | escape }}
                          {%- else -%}
                            {{ section.settings.shipping_text | default: 'zzgl. Versandkosten' | escape }}
                          {%- endif -%}
                        </span>
                      </p>
                    {%- endunless -%}
                    {%- unless variant.available -%}
                      <p class="sl-lp-option__soldout">Derzeit nicht verfügbar</p>
                    {%- endunless -%}
                  </div>
                  {%- if request.design_mode and s.dev_note != blank -%}
                    <p class="sl-lp-devnote">{{ s.dev_note | escape | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </fieldset>

            <div class="sl-lp-offer__submitrow">
              <button
                type="submit"
                name="add"
                id="sl-{{ track }}-cta"
                class="sl-lp-cta sl-lp-cta--signal sl-lp-cta--xl sl-lp-offer__submit"
                data-sl-track="offer_cta_click"
                {% unless default_variant.available %}disabled{% endunless %}
              >
                <span class="sl-lp-offer__submitlabel" data-sl-offer-label>{{ section.settings.cta_label | default: 'Jetzt absichern' | escape }}</span>
                {%- render 'loading-spinner' -%}
              </button>
              <p class="sl-lp-offer__summary" data-sl-offer-summary aria-live="polite">
                {{- default_title | escape }} · {{ default_total | money -}}
              </p>
              {%- render 'sl-lp-trust', items: section.settings.trust_items, align: 'center' -%}
            </div>
          {%- endform -%}
        </product-form>

        <div class="sl-lp-offer__meta">
          {%- if section.settings.price_note != blank -%}
            <p class="sl-lp-offer__note">{{ section.settings.price_note | escape }}</p>
          {%- endif -%}
          {%- if section.settings.shipping_link != blank -%}
            {%- capture ship_state -%}{%- render 'sl-lp-link-status', link: section.settings.shipping_link -%}{%- endcapture -%}
            {%- assign ship_state = ship_state | strip -%}
            {%- if ship_state == blank -%}
              <a class="sl-lp-link sl-lp-link--small" href="{{ section.settings.shipping_link | escape }}" data-sl-track="shipping_info_click">{{ section.settings.shipping_link_label | default: 'Versand & Lieferung' | escape }}</a>
            {%- elsif request.design_mode -%}
              <span class="sl-lp-card--dev-hidden" data-sl-unverified="{{ ship_state }}">{{ section.settings.shipping_link_label | default: 'Versand & Lieferung' | escape }} → {{ section.settings.shipping_link | escape }}</span>
              {%- render 'sl-lp-devflag', reason: ship_state -%}
            {%- endif -%}
          {%- endif -%}
          {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <ul class="sl-lp-offer__payments" role="list" aria-label="Verfügbare Zahlungsarten">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'sl-lp-offer__payicon' }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if section.settings.product_link_label != blank -%}
            <a class="sl-lp-link sl-lp-link--small" href="{{ default_product.url }}" data-sl-track="product_page_click">{{ section.settings.product_link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="sl-lp-devnote sl-lp-devnote--block">Bitte in den Angebots-Blöcken ein Produkt auswählen.</p>
      {%- endif -%}

      {%- if request.design_mode and section.settings.dev_note != blank -%}
        <p class="sl-lp-devnote sl-lp-devnote--block">{{ section.settings.dev_note | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.sticky_cta and section_live and default_product != blank -%}
      <div class="sl-lp-sticky" data-sl-sticky hidden>
        <div class="sl-lp-sticky__inner">
          <p class="sl-lp-sticky__text">
            {%- if section.settings.sticky_prefix != blank -%}
              <span>{{ section.settings.sticky_prefix | escape }}</span>
            {%- endif %}
            <strong>{{ min_total | money }}</strong>
          </p>
          <a
            href="#{{ anchor }}"
            id="sl-sticky-cta"
            class="sl-lp-cta sl-lp-cta--signal sl-lp-cta--small"
            data-sl-track="sticky_cta_click"
            data-sl-label="{{ section.settings.sticky_label | escape }}"
          >
            {{- section.settings.sticky_label | default: 'Jetzt absichern' | escape -}}
          </a>
        </div>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "LP · Angebot",
  "tag": "div",
  "class": "sl-lp-shopify-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Einzelpreis und Verfügbarkeit kommen live aus Shopify. Set-Preise nur aus dem Kaching-Deal übernehmen (siehe „Set-Preise“ unten)."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Sprungmarke (ID)",
      "default": "angebot"
    },
    {
      "type": "text",
      "id": "tracking_name",
      "label": "Tracking-Name",
      "default": "angebot"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Hintergrund",
      "options": [
        { "value": "white", "label": "Weiß" },
        { "value": "mist", "label": "Hellblau-Grau" },
        { "value": "sky", "label": "Heller Verlauf" }
      ],
      "default": "mist"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Abstand oben/unten",
      "options": [
        { "value": "compact", "label": "Kompakt" },
        { "value": "normal", "label": "Normal" },
        { "value": "large", "label": "Groß" }
      ],
      "default": "normal"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "Angebot"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift (H2)",
      "default": "Wähle jetzt den passenden Schutz für dein Wohnmobil."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschriftgröße",
      "options": [
        { "value": "s", "label": "Klein" },
        { "value": "m", "label": "Mittel" },
        { "value": "l", "label": "Groß" }
      ],
      "default": "m"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Einleitung"
    },
    {
      "type": "text",
      "id": "legend",
      "label": "Beschriftung Auswahl (Screenreader)",
      "default": "Anzahl der Geräte wählen"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Jetzt absichern"
    },
    {
      "type": "textarea",
      "id": "trust_items",
      "label": "Vertrauens-Merkmale unter dem Button",
      "info": "Ein Merkmal pro Zeile, nur belegte Aussagen. Zeilen mit [CLAIM VERIFIZIEREN] erscheinen nur im Editor."
    },
    {
      "type": "header",
      "content": "Set-Preise (Kaching-Mengenrabatt)"
    },
    {
      "type": "text",
      "id": "kaching_deal",
      "label": "Kaching-Deal-ID",
      "info": "Kurz-ID des Kaching-Deals (SICHERLUFT Mengenrabatt: ZuSp). Das Formular kennzeichnet den Artikel damit wie das Kaching-Widget, sonst greift der Rabatt im Warenkorb nicht. Leer = die Seite zeigt nur reguläre Preise."
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Preis-Hinweis unter den Angeboten",
      "default": "Streichpreis = Summe der Einzelpreise."
    },
    {
      "type": "header",
      "content": "Versand & Hinweise"
    },
    {
      "type": "text",
      "id": "free_shipping_text",
      "label": "Text ab Versandkostenfrei-Schwelle",
      "default": "versandkostenfrei (DE)",
      "info": "Schwelle kommt aus den Theme-Einstellungen (Cart Drawer → Amount limit for free shipping). Muss zur Versandrate in Shopify passen."
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Text unter der Schwelle",
      "default": "zzgl. Versandkosten"
    },
    {
      "type": "text",
      "id": "shipping_link",
      "label": "Link Versandinformationen",
      "info": "z. B. /pages/versand – erscheint live erst, wenn die Seite veröffentlicht ist."
    },
    {
      "type": "text",
      "id": "shipping_link_label",
      "label": "Linktext Versandinformationen",
      "default": "Versand & Lieferung"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Aktive Zahlungsarten anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "product_link_label",
      "label": "Link zur Produktseite (optional)",
      "info": "Leer lassen, um keinen Link zur Produktseite zu zeigen."
    },
    {
      "type": "header",
      "content": "Mobile Sticky-Leiste"
    },
    {
      "type": "checkbox",
      "id": "sticky_cta",
      "label": "Sticky-Leiste auf Mobilgeräten",
      "default": true,
      "info": "Erscheint nach dem Hero, verschwindet beim Angebot und am Seitenende. Zeigt den niedrigsten Preis. Keine Countdowns."
    },
    {
      "type": "text",
      "id": "sticky_prefix",
      "label": "Text vor dem Preis",
      "default": "ab"
    },
    {
      "type": "text",
      "id": "sticky_label",
      "label": "Beschriftung Sticky-Button",
      "default": "Jetzt absichern"
    },
    {
      "type": "textarea",
      "id": "dev_note",
      "label": "Interne Notiz",
      "info": "Nur im Editor sichtbar."
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Angebot",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produkt"
        },
        {
          "type": "range",
          "id": "quantity",
          "label": "Anzahl Geräte",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 1
        },
        {
          "type": "text",
          "id": "offer_price",
          "label": "Set-Preis gesamt (€)",
          "info": "Nur den Festpreis aus dem Kaching-Deal eintragen, z. B. 99,95. Leer = Einzelpreis × Anzahl. Wirkt nur mit Kaching-Deal-ID (Section-Einstellungen)."
        },
        {
          "type": "select",
          "id": "display",
          "label": "Darstellung",
          "options": [
            { "value": "card", "label": "Große Karte" },
            { "value": "compact", "label": "Kompakte Zeile unter den Karten" }
          ],
          "default": "card"
        },
        {
          "type": "text",
